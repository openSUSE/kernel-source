From 959a6d611adea0c2f6abb9b9bb81b6202fd4ef99 Mon Sep 17 00:00:00 2001
From: Ales Novak <alnovak@suse.com>
Date: Thu, 20 Aug 2026 21:57:25 +0200
Subject: [PATCH] kabi: tls add counters for rekey
Patch-mainline: Never, kabi workaround
References: bsc#1267564 jsc#PED-16401

Mask new MIB definitions for TLS that were added by the backport of
mainline commit 510128b30f2d ("tls: add counters for rekey").
LINUX_MIB_TLSMAX is used only in struct linux_tls_mib (referenced from
netns_mib), which is allocated per-CPU only in tls_init_net(). The new
array members are appended at the end, so hypothetical old users will
simply be unaware of them.

Signed-off-by: Ales Novak <alnovak@suse.com>
Reviewed-by: Petr Pavlu <petr.pavlu@suse.com>
---
 include/uapi/linux/snmp.h | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/include/uapi/linux/snmp.h b/include/uapi/linux/snmp.h
index 03eb0561396f7..2d4132dd0406f 100644
--- a/include/uapi/linux/snmp.h
+++ b/include/uapi/linux/snmp.h
@@ -350,11 +350,13 @@ enum
 	LINUX_MIB_TLSRXDEVICERESYNC,		/* TlsRxDeviceResync */
 	LINUX_MIB_TLSDECRYPTRETRY,		/* TlsDecryptRetry */
 	LINUX_MIB_TLSRXNOPADVIOL,		/* TlsRxNoPadViolation */
+#ifndef __GENKSYMS__
 	LINUX_MIB_TLSRXREKEYOK,			/* TlsRxRekeyOk */
 	LINUX_MIB_TLSRXREKEYERROR,		/* TlsRxRekeyError */
 	LINUX_MIB_TLSTXREKEYOK,			/* TlsTxRekeyOk */
 	LINUX_MIB_TLSTXREKEYERROR,		/* TlsTxRekeyError */
 	LINUX_MIB_TLSRXREKEYRECEIVED,		/* TlsRxRekeyReceived */
+#endif
 	__LINUX_MIB_TLSMAX
 };
 
