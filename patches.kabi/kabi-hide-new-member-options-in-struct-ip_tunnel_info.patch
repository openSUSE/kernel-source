From: Ricardo B. Marlière <rbm@suse.com>
Date: Wed, 26 Aug 2026 17:24:00 -0300
Subject: kabi: hide new member options in struct ip_tunnel_info
Patch-mainline: Never, kabi workaround
References: bsc#1274727

Backport of mainline commit bb5e62f2d547 ("net: Add options as a flexible
array to struct ip_tunnel_info") adds a new member options into struct
ip_tunnel_info. The member removes the hidden assumption that the options
are allocated at the end of the struct, and teaches the compiler about them
using a flexible array. The actual layout of ip_tunnel_info remains
unchanged.

Reviewed-by: Petr Pavlu <petr.pavlu@suse.com>
Signed-off-by: Ricardo B. Marlière <rbm@suse.com>
---
 include/net/ip_tunnels.h |   13 +++++++++++++
 1 file changed, 13 insertions(+)

--- a/include/net/ip_tunnels.h
+++ b/include/net/ip_tunnels.h
@@ -114,8 +114,21 @@
 #endif
 	u8			options_len;
 	u8			mode;
+#ifndef __GENKSYMS__
 	u8			options[] __aligned_largest __counted_by(options_len);
+#endif
+};
+
+struct __orig_ip_tunnel_info {
+	struct ip_tunnel_key	key;
+	struct ip_tunnel_encap	encap;
+#ifdef CONFIG_DST_CACHE
+	struct dst_cache	dst_cache;
+#endif
+	u8			options_len;
+	u8			mode;
 };
+suse_kabi_static_assert(sizeof(struct ip_tunnel_info) == sizeof(struct __orig_ip_tunnel_info));
 
 /* 6rd prefix/relay information */
 #ifdef CONFIG_IPV6_SIT_6RD
