From 2e07996b609d7f52bf863e86a201adcd943d6c58 Mon Sep 17 00:00:00 2001
From: Nicolas Morey <nmorey@suse.com>
Date: Mon, 12 Oct 2026 17:40:42 +0200
Subject: [PATCH] kABI fix for RDMA/rtrs-clt: Fix CQ pool leak when connect is
 interrupted
Patch-mainline: never, kabi
References: CVE-2026-98352 bsc#1284647

Upstream commit 2ae16aaa78b5 ("RDMA/rtrs-clt: Fix CQ pool leak when connect is interrupted")
adds a new byte-sized field to rtrs_clt_con.
The field falls within the padding ot the struct.

The struct is kzalloc by rtrs so is always initialized properly.

$ pahole -C  rtrs_clt_con build-x86_64/drivers/infiniband/ulp/rtrs/rtrs-clt-stats.o
struct rtrs_clt_con {
	struct rtrs_con            c;                    /*     0    48 */
	struct rtrs_iu *           rsp_ius;              /*    48     8 */
	u32                        queue_num;            /*    56     4 */
	unsigned int               cpu;                  /*    60     4 */
	/* --- cacheline 1 boundary (64 bytes) --- */
	struct mutex               con_mutex;            /*    64    32 */
	int                        cm_err;               /*    96     4 */

	/* size: 104, cachelines: 2, members: 6 */
	/* padding: 4 */
	/* last cacheline: 40 bytes */
};

Signed-off-by: Nicolas Morey <nmorey@suse.com>
Reviewed-by: Petr Pavlu <petr.pavlu@suse.com>
---
 drivers/infiniband/ulp/rtrs/rtrs-clt.h | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/drivers/infiniband/ulp/rtrs/rtrs-clt.h b/drivers/infiniband/ulp/rtrs/rtrs-clt.h
index 5ba486bfc7da..978a4f5f31db 100644
--- a/drivers/infiniband/ulp/rtrs/rtrs-clt.h
+++ b/drivers/infiniband/ulp/rtrs/rtrs-clt.h
@@ -67,6 +67,14 @@ struct rtrs_clt_stats {
 	struct rtrs_clt_stats_reconnects	reconnects;
 	atomic_t				inflight;
 };
+struct __orig_rtrs_clt_con {
+	struct rtrs_con	c;
+	struct rtrs_iu		*rsp_ius;
+	u32			queue_num;
+	unsigned int		cpu;
+	struct mutex		con_mutex;
+	int			cm_err;
+};
 
 struct rtrs_clt_con {
 	struct rtrs_con	c;
@@ -75,9 +83,13 @@ struct rtrs_clt_con {
 	unsigned int		cpu;
 	struct mutex		con_mutex;
 	int			cm_err;
+#ifndef __GENKSYMS__
 	/* Set under con_mutex before CQ/QP teardown. */
 	bool			destroyed;
+#endif
 };
+suse_kabi_static_assert(sizeof(struct __orig_rtrs_clt_con) ==
+			sizeof(struct rtrs_clt_con));
 
 /**
  * rtrs_permit - permits the memory allocation for future RDMA operation.
-- 
2.54.0

