From 2ec72c96006ee004ce6526152716955579073943 Mon Sep 17 00:00:00 2001
From: Oliver Neukum <oneukum@suse.com>
Date: Tue, 8 Sep 2026 16:03:51 +0200
Subject: [PATCH] replace additional lock in hci_conn with a common spinlock
References: CVE-2026-74533 bsc#1275804
Patch-mainline: Never (kABI fixup)

The new lock is not used much and only in one file.
It can be replaced with a static spinlock.

Signed-off-by: Oliver Neukum <oneukum@suse.com>
Reviewed-by: Jan Kara <jack@suse.cz>
---
 include/net/bluetooth/hci_core.h |    3 +--
 net/bluetooth/hci_conn.c         |    2 --
 net/bluetooth/iso.c              |   22 ++++++++++++----------
 3 files changed, 13 insertions(+), 14 deletions(-)

--- a/include/net/bluetooth/hci_core.h
+++ b/include/net/bluetooth/hci_core.h
@@ -741,10 +741,9 @@ struct hci_conn {
 
 	struct hci_dev	*hdev;
 
-	spinlock_t	proto_lock; /* lock guarding protocol data */
 	void		*l2cap_data;
 	void		*sco_data;
-	void		*iso_data __guarded_by(&proto_lock);
+	void		*iso_data;
 
 	struct list_head link_list;
 	struct hci_conn	*parent;
--- a/net/bluetooth/hci_conn.c
+++ b/net/bluetooth/hci_conn.c
@@ -1023,8 +1023,6 @@ static struct hci_conn *__hci_conn_add(s
 	INIT_DELAYED_WORK(&conn->idle_work, hci_conn_idle);
 	INIT_DELAYED_WORK(&conn->le_conn_timeout, le_conn_timeout);
 
-	spin_lock_init(&conn->proto_lock);
-
 	atomic_set(&conn->refcnt, 0);
 
 	hci_dev_hold(hdev);
--- a/net/bluetooth/iso.c
+++ b/net/bluetooth/iso.c
@@ -18,6 +18,8 @@
 
 static const struct proto_ops iso_sock_ops;
 
+static DEFINE_SPINLOCK(__suse_proto_lock);
+
 static struct bt_sock_list iso_sk_list = {
 	.lock = __RW_LOCK_UNLOCKED(iso_sk_list.lock)
 };
@@ -109,7 +111,7 @@ static void iso_conn_free(struct kref *r
 		iso_pi(conn->sk)->conn = NULL;
 
 	if (conn->hcon) {
-		spin_lock(&conn->hcon->proto_lock);
+		spin_lock(&__suse_proto_lock);
 
 		/* Check we are not racing with iso_conn_add */
 		if (conn->hcon->iso_data == conn) {
@@ -118,7 +120,7 @@ static void iso_conn_free(struct kref *r
 				hci_conn_drop(conn->hcon);
 		}
 
-		spin_unlock(&conn->hcon->proto_lock);
+		spin_unlock(&__suse_proto_lock);
 	}
 
 	kfree_skb(conn->rx_skb);
@@ -222,7 +224,7 @@ static struct iso_conn *iso_conn_add(str
 {
 	struct iso_conn *conn;
 
-	spin_lock(&hcon->proto_lock);
+	spin_lock(&__suse_proto_lock);
 
 	conn = iso_conn_hold_unless_zero(hcon->iso_data);
 	if (conn) {
@@ -232,13 +234,13 @@ static struct iso_conn *iso_conn_add(str
 			iso_conn_unlock(conn);
 		}
 		iso_conn_put(conn);
-		spin_unlock(&hcon->proto_lock);
+		spin_unlock(&__suse_proto_lock);
 		return conn;
 	}
 
 	conn = kzalloc(sizeof(*conn), GFP_ATOMIC);
 	if (!conn) {
-		spin_unlock(&hcon->proto_lock);
+		spin_unlock(&__suse_proto_lock);
 		return NULL;
 	}
 
@@ -249,7 +251,7 @@ static struct iso_conn *iso_conn_add(str
 	conn->hcon = hcon;
 	conn->tx_sn = 0;
 
-	spin_unlock(&hcon->proto_lock);
+	spin_unlock(&__suse_proto_lock);
 
 	BT_DBG("hcon %p conn %p", hcon, conn);
 
@@ -294,9 +296,9 @@ static void iso_conn_del(struct hci_conn
 	struct iso_conn *conn;
 	struct sock *sk;
 
-	spin_lock(&hcon->proto_lock);
+	spin_lock(&__suse_proto_lock);
 	conn = iso_conn_hold_unless_zero(hcon->iso_data);
-	spin_unlock(&hcon->proto_lock);
+	spin_unlock(&__suse_proto_lock);
 	if (!conn)
 		return;
 
@@ -321,12 +323,12 @@ static void iso_conn_del(struct hci_conn
 
 done:
 	/* No sk access to conn->hcon any more (lock_sock + hdev->lock) */
-	spin_lock(&hcon->proto_lock);
+	spin_lock(&__suse_proto_lock);
 	iso_conn_lock(conn);
 	conn->hcon = NULL;
 	hcon->iso_data = NULL;
 	iso_conn_unlock(conn);
-	spin_unlock(&hcon->proto_lock);
+	spin_unlock(&__suse_proto_lock);
 
 	iso_conn_put(conn);
 }
