From: Michal Kubecek <mkubecek@suse.cz>
Date: Wed, 2 Sep 2026 13:42:13 +0200
Subject: kabi: move skb_dev out of struct nf_queue_entry
Patch-mainline: Never, kabi workaround
References: CVE-2026-52912 bsc#1269000

Backport of mainline commit e196115ec330 ("netfilter: nf_queue: hold bridge
skb->dev while queued") inserts a pointer skb_dev into kabi protected
struct nf_queue_entry. As additional data is expected to be placed right
after the structure, moving the pointer to the end of the structure would
be too complicated.

Instances of struct nf_queue_entry are only allocated in __nf_queue() and
freed either in error paths of the same function or nf_queue_entry_free()
helper. Therefore we can put the structure into a wrapper that would be
allocated and freed instead.

Signed-off-by: Michal Kubecek <mkubecek@suse.cz>
Reviewed-by: Jan Kara <jack@suse.cz>
---
 include/net/netfilter/nf_queue.h | 18 +++++++++++++++++-
 net/netfilter/nf_queue.c         | 25 +++++++++++++++----------
 net/netfilter/nfnetlink_queue.c  |  3 ++-
 3 files changed, 34 insertions(+), 12 deletions(-)

--- a/include/net/netfilter/nf_queue.h
+++ b/include/net/netfilter/nf_queue.h
@@ -12,7 +12,6 @@
 struct nf_queue_entry {
 	struct list_head	list;
 	struct sk_buff		*skb;
-	struct net_device	*skb_dev;
 	unsigned int		id;
 	unsigned int		hook_index;	/* index in hook_entries->hook[] */
 #if IS_ENABLED(CONFIG_BRIDGE_NETFILTER)
@@ -27,6 +26,23 @@ struct nf_queue_entry {
 
 #define nf_queue_entry_reroute(x) ((void *)x + sizeof(struct nf_queue_entry))
 
+struct nf_queue_entry_kabi_wrapper {
+	struct net_device	*skb_dev;
+	struct nf_queue_entry	entry;
+};
+
+/* make sure allocated size matches what was expected without the wrapper */
+static_assert(sizeof(struct nf_queue_entry_kabi_wrapper) ==
+	      sizeof(struct net_device *) + sizeof(struct nf_queue_entry));
+
+static inline struct net_device *nf_queue_entry_skbdev(const struct nf_queue_entry *e)
+{
+	const struct nf_queue_entry_kabi_wrapper *wrapper =
+		container_of(e, const struct nf_queue_entry_kabi_wrapper, entry);
+
+	return wrapper->skb_dev;
+}
+
 /* Packet queuing */
 struct nf_queue_handler {
 	int		(*outfn)(struct nf_queue_entry *entry,
--- a/net/netfilter/nf_queue.c
+++ b/net/netfilter/nf_queue.c
@@ -51,8 +51,8 @@ static void nf_queue_entry_release_refs(struct nf_queue_entry *entry)
 	struct nf_hook_state *state = &entry->state;
 
 	/* Release those devices we held, or Alexey will kill me. */
-	if (entry->skb_dev)
-		dev_put(entry->skb_dev);
+	if (nf_queue_entry_skbdev(entry))
+		dev_put(nf_queue_entry_skbdev(entry));
 	if (state->in)
 		dev_put(state->in);
 	if (state->out)
@@ -70,8 +70,11 @@ static void nf_queue_entry_release_refs(struct nf_queue_entry *entry)
 
 void nf_queue_entry_free(struct nf_queue_entry *entry)
 {
+	struct nf_queue_entry_kabi_wrapper *wrapper =
+		container_of(entry, struct nf_queue_entry_kabi_wrapper, entry);
+
 	nf_queue_entry_release_refs(entry);
-	kfree(entry);
+	kfree(wrapper);
 }
 EXPORT_SYMBOL_GPL(nf_queue_entry_free);
 
@@ -100,8 +103,8 @@ bool __nf_queue_entry_get_refs(struct nf_queue_entry *entry)
 	if (state->sk && !refcount_inc_not_zero(&state->sk->sk_refcnt))
 		return false;
 
-	if (entry->skb_dev)
-		dev_hold(entry->skb_dev);
+	if (nf_queue_entry_skbdev(entry))
+		dev_hold(nf_queue_entry_skbdev(entry));
 	if (state->in)
 		dev_hold(state->in);
 	if (state->out)
@@ -182,6 +185,7 @@ static void nf_ip6_saveroute(const struct sk_buff *skb,
 static int __nf_queue(struct sk_buff *skb, const struct nf_hook_state *state,
 		      unsigned int index, unsigned int queuenum)
 {
+	struct nf_queue_entry_kabi_wrapper *wrapper;
 	struct nf_queue_entry *entry = NULL;
 	const struct nf_queue_handler *qh;
 	struct net *net = state->net;
@@ -205,26 +209,27 @@ static int __nf_queue(struct sk_buff *skb, const struct nf_hook_state *state,
 		break;
 	}
 
-	entry = kmalloc(sizeof(*entry) + route_key_size, GFP_ATOMIC);
-	if (!entry)
+	wrapper = kmalloc(sizeof(*wrapper) + route_key_size, GFP_ATOMIC);
+	if (!wrapper)
 		return -ENOMEM;
+	entry = &wrapper->entry;
 
 	if (skb_dst(skb) && !skb_dst_force(skb)) {
-		kfree(entry);
+		kfree(wrapper);
 		return -ENETDOWN;
 	}
 
 	*entry = (struct nf_queue_entry) {
 		.skb	= skb,
-		.skb_dev = skb->dev,
 		.state	= *state,
 		.hook_index = index,
 		.size	= sizeof(*entry) + route_key_size,
 	};
+	wrapper->skb_dev = skb->dev;
 	__nf_queue_entry_init_physdevs(entry);
 
 	if (!__nf_queue_entry_get_refs(entry)) {
-		kfree(entry);
+		kfree(wrapper);
 		return -ENOTCONN;
 	}
 
--- a/net/netfilter/nfnetlink_queue.c
+++ b/net/netfilter/nfnetlink_queue.c
@@ -912,7 +912,8 @@ dev_cmp(struct nf_queue_entry *entry, unsigned long ifindex)
 	if (physinif == ifindex || physoutif == ifindex)
 		return 1;
 #endif
-	if (entry->skb_dev && entry->skb_dev->ifindex == ifindex)
+	if (nf_queue_entry_skbdev(entry) &&
+	    nf_queue_entry_skbdev(entry)->ifindex == ifindex)
 		return 1;
 	if (entry->state.in)
 		if (entry->state.in->ifindex == ifindex)
