From: Martin Jabůrek <martin.jaburek@suse.com>
Subject: kABI: netfilter: nf_tables: make nft_object rhltable per table
Patch-mainline: Never, kABI workaround
References: CVE-2026-74565 bsc#1275568

Fix kABI breakage introduced by backporting upstream patch:
netfilter: nf_tables: make nft_object rhltable per table
(commit f4f699790590).

A new struct rhltable member was added to struct nft_table.
Due to its size, there is no sufficient padding to fit
this member. Conveniently though, the upstream patch adds the
functionality to create this new member together with the containing
nft_table. This is implemented in the nf_tables_newtable, where
both are allocated. Furthermore, nft_table is never embedded
in another struct, only linked via pointer received from nf_tables_newtable.
For this reason, adding the new rhltable member at the end
of the structure should suffice as a kABI workaround.

Additionally, two functions have changed signatures in this patch.
nft_obj_del is denoted as static, meaning it does not affect the
kABI. nft_obj_lookup however removes a const qualifier from
one of its parameters. This has been dealt with using the standard
__GENKSYMS__ macro, wrapped around the old parameter and its else
clause with the new parameter.

Signed-off-by: Martin Jabůrek <martin.jaburek@suse.com>
Reviewed-by: Petr Pavlu <petr.pavlu@suse.com>
---
 include/net/netfilter/nf_tables.h |   10 ++++++++--
 net/netfilter/nf_tables_api.c     |    4 ++++
 2 files changed, 12 insertions(+), 2 deletions(-)

--- a/include/net/netfilter/nf_tables.h
+++ b/include/net/netfilter/nf_tables.h
@@ -1277,7 +1277,6 @@ static inline void nft_use_inc_restore(u
  *	@sets: sets in the table
  *	@objects: stateful objects in the table
  *	@flowtables: flow tables in the table
- *	@objname_ht: hashtable for objects lookup by name
  *	@hgenerator: handle generator state
  *	@handle: table handle
  *	@use: number of chain references to this table
@@ -1286,6 +1285,7 @@ static inline void nft_use_inc_restore(u
  *	@afinfo: address family info
  *	@name: name of the table
  *	@validate_state: internal, set when transaction adds jumps
+ *	@objname_ht: hashtable for objects lookup by name
  */
 struct nft_table {
 	struct list_head		list;
@@ -1294,7 +1294,6 @@ struct nft_table {
 	struct list_head		sets;
 	struct list_head		objects;
 	struct list_head		flowtables;
-	struct rhltable			objname_ht;
 	u64				hgenerator;
 	u64				handle;
 	u32				use;
@@ -1306,6 +1305,9 @@ struct nft_table {
 	u16				udlen;
 	u8				*udata;
 	u8				validate_state;
+#ifndef __GENKSYMS__
+	struct rhltable			objname_ht;
+#endif
 };
 
 static inline bool nft_table_has_owner(const struct nft_table *table)
@@ -1374,7 +1376,11 @@ static inline void *nft_obj_data(const s
 #define nft_expr_obj(expr)	*((struct nft_object **)nft_expr_priv(expr))
 
 struct nft_object *nft_obj_lookup(const struct net *net,
+#ifdef __GENKSYMS__
+				  const struct nft_table *table,
+#else
 				  struct nft_table *table,
+#endif
 				  const struct nlattr *nla, u32 objtype,
 				  u8 genmask);
 
--- a/net/netfilter/nf_tables_api.c
+++ b/net/netfilter/nf_tables_api.c
@@ -7416,7 +7416,11 @@ void nft_unregister_obj(struct nft_objec
 EXPORT_SYMBOL_GPL(nft_unregister_obj);
 
 struct nft_object *nft_obj_lookup(const struct net *net,
+#ifdef __GENKSYMS__
+				  const struct nft_table *table,
+#else
 				  struct nft_table *table,
+#endif
 				  const struct nlattr *nla, u32 objtype,
 				  u8 genmask)
 {
