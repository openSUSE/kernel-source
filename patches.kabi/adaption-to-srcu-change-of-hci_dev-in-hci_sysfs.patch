From a19a14e59759d0e41d2d84bf1f3e439bba4e637f Mon Sep 17 00:00:00 2001
From: Oliver Neukum <oneukum@suse.com>
Date: Tue, 28 Jul 2026 13:36:49 +0200
Subject: [PATCH] adaption to srcu change of hci_dev in hci_sysfs
Patch-mainline: Never, kABI fixup
References: CVE-2026-53252 bsc#1269307

The prior fixup to hci_dev used a global variable. We need to adapt
to that by switching to a synchronization. In addition, being needed
in two files, it can no longer be static.

Signed-off-by: Oliver Neukum <oneukum@suse.com>
Reviewed-by: Takashi Iwai <tiwai@suse.com>
---
 net/bluetooth/hci_core.c  |    2 +-
 net/bluetooth/hci_sysfs.c |    4 +++-
 2 files changed, 4 insertions(+), 2 deletions(-)

--- a/net/bluetooth/hci_core.c
+++ b/net/bluetooth/hci_core.c
@@ -64,7 +64,7 @@ DEFINE_MUTEX(hci_cb_list_lock);
 static DEFINE_IDA(hci_index_ida);
 
 /* FIXME: global SRCU instead of hci_dev.srcu for kABI compatibility */
-DEFINE_STATIC_SRCU(__hci_dev_srcu);
+DEFINE_SRCU(__hci_dev_srcu);
 
 /* FIXME: global spinlock instead of discovery_state.lock for kABI */
 DEFINE_SPINLOCK(__hci_dev_discovery_lock);
--- a/net/bluetooth/hci_sysfs.c
+++ b/net/bluetooth/hci_sysfs.c
@@ -6,6 +6,8 @@
 #include <net/bluetooth/bluetooth.h>
 #include <net/bluetooth/hci_core.h>
 
+extern struct srcu_struct __hci_dev_srcu;
+
 static const struct class bt_class = {
 	.name = "bluetooth",
 };
@@ -86,7 +88,7 @@ static void bt_host_release(struct devic
 	if (hci_dev_test_flag(hdev, HCI_UNREGISTER)) {
 		hci_release_dev(hdev);
 	} else {
-		cleanup_srcu_struct(&hdev->srcu);
+		synchronize_srcu(&__hci_dev_srcu);
 		kfree(hdev);
 	}
 	module_put(THIS_MODULE);
