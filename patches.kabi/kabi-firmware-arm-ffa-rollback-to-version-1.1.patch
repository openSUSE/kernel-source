From: "Ivan T. Ivanov" <iivanov@suse.de>
Date: Fri, 11 Sep 2026 18:29:09 +0300
Subject: kABI: firmware: arm_ffa: Rollback driver to version 1.1
Patch-mainline: Never, kABI workaround
References: bsc#1274912 CVE-2026-68400

To be able to fix this CVE I have to backport [1] which depends on [2],
but all what is needed is ffa_mem_desc_offset() and ffa_emad_size_get().

Remove ffa_mem_region_attributes::impdef_val which breaks kABI and
it is needed only if driver version support FFA version > 1.1.

Cleanup definitions and functions which refers to removed structure
member.

[1] b4d961351aa8 ("firmware: arm_ffa: Add support for IMPDEF value in the memory access descriptor")
[2] 9fac08d9d985 ("firmware: arm_ffa: Upgrade FF-A version to v1.2 in the driver")

Acked-by: Ivan T. Ivanov <iivanov@suse.de>
Reviewed-by: Jan Kara <jack@suse.cz>
---
 drivers/firmware/arm_ffa/driver.c |   13 +------------
 include/linux/arm_ffa.h           |    7 +------
 2 files changed, 2 insertions(+), 18 deletions(-)

--- a/drivers/firmware/arm_ffa/driver.c
+++ b/drivers/firmware/arm_ffa/driver.c
@@ -45,7 +45,7 @@
 
 #include "common.h"
 
-#define FFA_DRIVER_VERSION	FFA_VERSION_1_2
+#define FFA_DRIVER_VERSION	FFA_VERSION_1_1
 #define FFA_MIN_VERSION		FFA_VERSION_1_0
 
 #define SENDER_ID_MASK		GENMASK(31, 16)
@@ -613,14 +613,6 @@ static u16 ffa_memory_attributes_get(u32
 	return FFA_MEM_NORMAL | FFA_MEM_WRITE_BACK | FFA_MEM_INNER_SHAREABLE;
 }
 
-static void ffa_emad_impdef_value_init(u32 version, void *dst, void *src)
-{
-	struct ffa_mem_region_attributes *ep_mem_access;
-
-	if (FFA_EMAD_HAS_IMPDEF_FIELD(version))
-		memcpy(dst, src, sizeof(ep_mem_access->impdef_val));
-}
-
 static void
 ffa_mem_region_additional_setup(u32 version, struct ffa_mem_region *mem_region)
 {
@@ -674,9 +666,6 @@ ffa_setup_and_transmit(u32 func_id, void
 		ep_mem_access->composite_off = composite_offset;
 		ep_mem_access->flag = 0;
 		ep_mem_access->reserved = 0;
-		ffa_emad_impdef_value_init(drv_info->version,
-					   ep_mem_access->impdef_val,
-					   args->attrs[idx].impdef_val);
 	}
 	mem_region->handle = 0;
 	mem_region->ep_count = args->nattrs;
--- a/include/linux/arm_ffa.h
+++ b/include/linux/arm_ffa.h
@@ -326,7 +326,6 @@ struct ffa_mem_region_attributes {
 	 * an `struct ffa_mem_region_addr_range`.
 	 */
 	u32 composite_off;
-	u8 impdef_val[16];
 	u64 reserved;
 };
 
@@ -406,7 +405,6 @@ struct ffa_mem_region {
 #define CONSTITUENTS_OFFSET(x)	\
 	(offsetof(struct ffa_composite_mem_region, constituents[x]))
 
-#define FFA_EMAD_HAS_IMPDEF_FIELD(version)	((version) >= FFA_VERSION_1_2)
 #define FFA_MEM_REGION_HAS_EP_MEM_OFFSET(version) ((version) > FFA_VERSION_1_0)
 
 /* The layout changed from FFA_VERSION_1_0 and the region includes an
@@ -421,10 +419,7 @@ static inline u32 ffa_emad_size_get(u32
 	u32 sz;
 	struct ffa_mem_region_attributes *ep_mem_access;
 
-	if (FFA_EMAD_HAS_IMPDEF_FIELD(ffa_version))
-		sz = sizeof(*ep_mem_access);
-	else
-		sz = sizeof(*ep_mem_access) - sizeof(ep_mem_access->impdef_val);
+	sz = sizeof(*ep_mem_access);
 
 	return sz;
 }
