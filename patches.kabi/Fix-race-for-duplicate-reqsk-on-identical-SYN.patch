From: Steffen Jaeckel <sjaeckel@suse.de>
Subject: Fix race for duplicate reqsk on identical SYN
Patch-mainline: Never, kABI workaround
References: CVE-2026-53260 bsc#1269731

This is a kABI fix for upstream commit ff46e3b44219 ("Fix race
for duplicate reqsk on identical SYN") which changed the API signature
of inet_csk_reqsk_queue_hash_add() to return a bool.

1. Rename the new version and use that.
2. Re-introduce the original API which simply calls the renamed new one and
   discards the return value.

Signed-off-by: Steffen Jaeckel <sjaeckel@suse.de>
Reviewed-by: Jan Kara <jack@suse.cz>
---
 include/net/inet_connection_sock.h |  6 ++++--
 net/dccp/ipv4.c                    |  2 +-
 net/dccp/ipv6.c                    |  2 +-
 net/ipv4/inet_connection_sock.c    | 10 +++++++++-
 net/ipv4/tcp_input.c               |  2 +-
 5 files changed, 16 insertions(+), 6 deletions(-)

diff --git a/include/net/inet_connection_sock.h b/include/net/inet_connection_sock.h
index 61e6cf423e74..f22cc57984e6 100644
--- a/include/net/inet_connection_sock.h
+++ b/include/net/inet_connection_sock.h
@@ -262,8 +262,10 @@ struct dst_entry *inet_csk_route_child_sock(const struct sock *sk,
 struct sock *inet_csk_reqsk_queue_add(struct sock *sk,
 				      struct request_sock *req,
 				      struct sock *child);
-bool inet_csk_reqsk_queue_hash_add(struct sock *sk, struct request_sock *req,
-				   unsigned long timeout);
+void inet_csk_reqsk_queue_hash_add(struct sock *sk, struct request_sock *req,
+                                   unsigned long timeout);
+bool __inet_csk_reqsk_queue_hash_add(struct sock *sk, struct request_sock *req,
+                                     unsigned long timeout);
 struct sock *inet_csk_complete_hashdance(struct sock *sk, struct sock *child,
 					 struct request_sock *req,
 					 bool own_req);
diff --git a/net/dccp/ipv4.c b/net/dccp/ipv4.c
index 24c55132db79..6dd971e5d558 100644
--- a/net/dccp/ipv4.c
+++ b/net/dccp/ipv4.c
@@ -647,7 +647,7 @@ int dccp_v4_conn_request(struct sock *sk, struct sk_buff *skb)
 	if (dccp_v4_send_response(sk, req))
 		goto drop_and_free;
 
-	if (unlikely(!inet_csk_reqsk_queue_hash_add(sk, req, DCCP_TIMEOUT_INIT)))
+	if (unlikely(!__inet_csk_reqsk_queue_hash_add(sk, req, DCCP_TIMEOUT_INIT)))
 		reqsk_free(req);
 	else
 		reqsk_put(req);
diff --git a/net/dccp/ipv6.c b/net/dccp/ipv6.c
index 2989d7d7bdc8..00b487ae0db5 100644
--- a/net/dccp/ipv6.c
+++ b/net/dccp/ipv6.c
@@ -397,7 +397,7 @@ static int dccp_v6_conn_request(struct sock *sk, struct sk_buff *skb)
 	if (dccp_v6_send_response(sk, req))
 		goto drop_and_free;
 
-	if (unlikely(!inet_csk_reqsk_queue_hash_add(sk, req, DCCP_TIMEOUT_INIT)))
+	if (unlikely(!__inet_csk_reqsk_queue_hash_add(sk, req, DCCP_TIMEOUT_INIT)))
 		reqsk_free(req);
 	else
 		reqsk_put(req);
diff --git a/net/ipv4/inet_connection_sock.c b/net/ipv4/inet_connection_sock.c
index 1e66df9f0f0f..1bc43ee228cc 100644
--- a/net/ipv4/inet_connection_sock.c
+++ b/net/ipv4/inet_connection_sock.c
@@ -947,7 +947,7 @@ static bool reqsk_queue_hash_req(struct request_sock *req,
 	return true;
 }
 
-bool inet_csk_reqsk_queue_hash_add(struct sock *sk, struct request_sock *req,
+bool __inet_csk_reqsk_queue_hash_add(struct sock *sk, struct request_sock *req,
 				   unsigned long timeout)
 {
 	if (!reqsk_queue_hash_req(req, timeout))
@@ -956,6 +956,14 @@ bool inet_csk_reqsk_queue_hash_add(struct sock *sk, struct request_sock *req,
 	inet_csk_reqsk_queue_added(sk);
 	return true;
 }
+EXPORT_SYMBOL_GPL(__inet_csk_reqsk_queue_hash_add);
+
+void inet_csk_reqsk_queue_hash_add(struct sock *sk, struct request_sock *req,
+                                   unsigned long timeout)
+{
+	if (!__inet_csk_reqsk_queue_hash_add(sk, req, timeout))
+		refcount_set(&req->rsk_refcnt, 1);
+}
 EXPORT_SYMBOL_GPL(inet_csk_reqsk_queue_hash_add);
 
 static void inet_clone_ulp(const struct request_sock *req, struct sock *newsk,
diff --git a/net/ipv4/tcp_input.c b/net/ipv4/tcp_input.c
index 571c59a628d2..d6e220707745 100644
--- a/net/ipv4/tcp_input.c
+++ b/net/ipv4/tcp_input.c
@@ -6901,7 +6901,7 @@ int tcp_conn_request(struct request_sock_ops *rsk_ops,
 	} else {
 		tcp_rsk(req)->tfo_listener = false;
 		if (!want_cookie) {
-			if (unlikely(!inet_csk_reqsk_queue_hash_add(sk, req,
+			if (unlikely(!__inet_csk_reqsk_queue_hash_add(sk, req,
 								    tcp_timeout_init((struct sock *)req)))) {
 				reqsk_free(req);
 				dst_release(dst);
-- 
