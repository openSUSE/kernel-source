From: Michal Kubecek <mkubecek@suse.cz>
Date: Wed, 4 Nov 2026 23:13:30 +0100
Subject: kabi: hide tx_work_disabled flag in struct netpoll_info
Patch-mainline: Never, kabi workaround
References: CVE-2026-64424 bsc#1274256

To backport mainline commit 45f1458a8501 ("netpoll: fix a use-after-free on
shutdown path") into kernels without disable_delayed_work_sync(), we add
a bool member tx_work_disabled to struct netpoll_info which is kABI
protected.

Thankfully the new member fits into a 4-byte hole between refcnt and
dev_lock so that hiding it from genksyms is sufficient. A static assert
is addded to check that the offset of the following member (dev_lock) is
preserved.

(gdb) ptype /o struct netpoll_info
/* offset      |    size */  type = struct netpoll_info {
/*      0      |       4 */    atomic_t refcnt;
/* XXX  4-byte hole      */
/*      8      |      24 */    struct semaphore {
...
                               } dev_lock;
...

Signed-off-by: Michal Kubecek <mkubecek@suse.cz>
Reviewed-by: Jan Kara <jack@suse.cz>
---
 include/linux/netpoll.h | 18 +++++++++++++++++-
 1 file changed, 17 insertions(+), 1 deletion(-)

--- a/include/linux/netpoll.h
+++ b/include/linux/netpoll.h
@@ -33,10 +33,24 @@ struct netpoll {
 	struct work_struct cleanup_work;
 };
 
-struct netpoll_info {
+struct __orig_netpoll_info {
 	atomic_t refcnt;
 
+	struct semaphore dev_lock;
+
+	struct sk_buff_head txq;
+
+	struct delayed_work tx_work;
+
+	struct netpoll *netpoll;
+	struct rcu_head rcu;
+};
+
+struct netpoll_info {
+	atomic_t refcnt;
+#ifndef __GENKSYMS__
 	bool tx_work_disabled;
+#endif
 
 	struct semaphore dev_lock;
 
@@ -47,6 +61,8 @@ struct netpoll_info {
 	struct netpoll *netpoll;
 	struct rcu_head rcu;
 };
+suse_kabi_static_assert(offsetof(struct netpoll_info, dev_lock) ==
+			offsetof(struct __orig_netpoll_info, dev_lock));
 
 #ifdef CONFIG_NETPOLL
 void netpoll_poll_dev(struct net_device *dev);
