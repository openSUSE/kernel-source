From: Juergen Gross <jgross@suse.com>
Patch-mainline: never, kabi
References: jsc#PED-17051
Subject: [PATCH] kABI fix after enabling iommufd

For KATA containers the following additional CONFIG options are needed:

CONFIG_VFIO_DEVICE_CDEV=y
CONFIG_IOMMUFD=y
CONFIG_IOMMUFD_VFIO_CONTAINER=y

The last one implies CONFIG_VFIO_CONTAINER to be disabled.

For preserving kABI the following changes are needed:

In struct vfio_group the member 'container_next' is defined only if
CONFIG_VFIO_CONTAINER is set. Expand that to define it with
CONFIG_IOMMUFD_VFIO_CONTAINER, too.

struct vfio_device is gaining several new fields, but it can't grow
in size as it is often embedded into other structures. OTOH there are
central allocation and release helpers, which enables to create a new
kABI extension hooked into struct vfio_device (this is working due to
all new fields being in the vfio private section AND the possibility
to rearrange some private fields to get space for the pointer to the
new kABI extension).

With CONFIG_IOMMUFD_VFIO_CONTAINER set and CONFIG_VFIO_CONTAINER unset
vfio_[un]register_iommu_driver() are no longer present. For preserving
kABI they can be implemented as dummy functions, as the registered
callbacks are no longer used anywhere.

Signed-off-by: Juergen Gross <jgross@suse.com>
Reviewed-by: Jan Kara <jack@suse.cz>
---
 drivers/vfio/Makefile       |    2 +-
 drivers/vfio/container.c    |   14 +++++++
 drivers/vfio/device_cdev.c  |    6 ++--
 drivers/vfio/iommufd.c      |   46 ++++++++++++------------
 drivers/vfio/vfio.h         |   10 +++--
 drivers/vfio/vfio_main.c    |    3 ++-
 include/linux/vfio.h        |   25 +++++++++----
 7 files changed, 68 insertions(+), 39 deletions(-)

--- a/drivers/vfio/Makefile
+++ b/drivers/vfio/Makefile
@@ -5,7 +5,7 @@
 vfio-$(CONFIG_VFIO_DEVICE_CDEV) += device_cdev.o
 vfio-$(CONFIG_VFIO_GROUP) += group.o
 vfio-$(CONFIG_IOMMUFD) += iommufd.o
-vfio-$(CONFIG_VFIO_CONTAINER) += container.o
+vfio-y += container.o
 vfio-$(CONFIG_VFIO_VIRQFD) += virqfd.o
 vfio-$(CONFIG_VFIO_DEBUGFS) += debugfs.o
 
--- a/drivers/vfio/container.c
+++ b/drivers/vfio/container.c
@@ -15,6 +15,7 @@
 
 #include "vfio.h"
 
+#ifdef CONFIG_VFIO_CONTAINER
 struct vfio_container {
 	struct kref			kref;
 	struct list_head		group_list;
@@ -605,3 +606,16 @@
 
 MODULE_ALIAS_MISCDEV(VFIO_MINOR);
 MODULE_ALIAS("devname:vfio/vfio");
+
+#else
+int vfio_register_iommu_driver(const struct vfio_iommu_driver_ops *ops)
+{
+	return 0;
+}
+EXPORT_SYMBOL_GPL(vfio_register_iommu_driver);
+
+void vfio_unregister_iommu_driver(const struct vfio_iommu_driver_ops *ops)
+{
+}
+EXPORT_SYMBOL_GPL(vfio_unregister_iommu_driver);
+#endif
--- a/drivers/vfio/device_cdev.c
+++ b/drivers/vfio/device_cdev.c
@@ -12,8 +12,8 @@
 void vfio_init_device_cdev(struct vfio_device *device)
 {
 	device->device.devt = MKDEV(MAJOR(device_devt), device->index);
-	cdev_init(&device->cdev, &vfio_device_fops);
-	device->cdev.owner = THIS_MODULE;
+	cdev_init(&device->kabi_ext->cdev, &vfio_device_fops);
+	device->kabi_ext->cdev.owner = THIS_MODULE;
 }
 
 /*
@@ -23,7 +23,7 @@ void vfio_init_device_cdev(struct vfio_device *device)
 int vfio_device_fops_cdev_open(struct inode *inode, struct file *filep)
 {
 	struct vfio_device *device = container_of(inode->i_cdev,
-						  struct vfio_device, cdev);
+			struct vfio_device_kabi_ext, cdev)->vfio_device;
 	struct vfio_device_file *df;
 	int ret;
 
--- a/drivers/vfio/iommufd.c
+++ b/drivers/vfio/iommufd.c
@@ -67,16 +67,16 @@ void vfio_df_iommufd_unbind(struct vfio_
 
 struct iommufd_ctx *vfio_iommufd_device_ictx(struct vfio_device *vdev)
 {
-	if (vdev->iommufd_device)
-		return iommufd_device_to_ictx(vdev->iommufd_device);
+	if (vdev->kabi_ext->iommufd_device)
+		return iommufd_device_to_ictx(vdev->kabi_ext->iommufd_device);
 	return NULL;
 }
 EXPORT_SYMBOL_GPL(vfio_iommufd_device_ictx);
 
 static int vfio_iommufd_device_id(struct vfio_device *vdev)
 {
-	if (vdev->iommufd_device)
-		return iommufd_device_to_id(vdev->iommufd_device);
+	if (vdev->kabi_ext->iommufd_device)
+		return iommufd_device_to_id(vdev->kabi_ext->iommufd_device);
 	return -EINVAL;
 }
 
@@ -122,7 +122,7 @@ int vfio_iommufd_physical_bind(struct vf
 	idev = iommufd_device_bind(ictx, vdev->dev, out_device_id);
 	if (IS_ERR(idev))
 		return PTR_ERR(idev);
-	vdev->iommufd_device = idev;
+	vdev->kabi_ext->iommufd_device = idev;
 	return 0;
 }
 EXPORT_SYMBOL_GPL(vfio_iommufd_physical_bind);
@@ -131,12 +131,12 @@ void vfio_iommufd_physical_unbind(struct
 {
 	lockdep_assert_held(&vdev->dev_set->lock);
 
-	if (vdev->iommufd_attached) {
-		iommufd_device_detach(vdev->iommufd_device);
-		vdev->iommufd_attached = false;
+	if (vdev->kabi_ext->iommufd_attached) {
+		iommufd_device_detach(vdev->kabi_ext->iommufd_device);
+		vdev->kabi_ext->iommufd_attached = false;
 	}
-	iommufd_device_unbind(vdev->iommufd_device);
-	vdev->iommufd_device = NULL;
+	iommufd_device_unbind(vdev->kabi_ext->iommufd_device);
+	vdev->kabi_ext->iommufd_device = NULL;
 }
 EXPORT_SYMBOL_GPL(vfio_iommufd_physical_unbind);
 
@@ -146,16 +146,16 @@ int vfio_iommufd_physical_attach_ioas(st
 
 	lockdep_assert_held(&vdev->dev_set->lock);
 
-	if (WARN_ON(!vdev->iommufd_device))
+	if (WARN_ON(!vdev->kabi_ext->iommufd_device))
 		return -EINVAL;
 
-	if (vdev->iommufd_attached)
-		rc = iommufd_device_replace(vdev->iommufd_device, pt_id);
+	if (vdev->kabi_ext->iommufd_attached)
+		rc = iommufd_device_replace(vdev->kabi_ext->iommufd_device, pt_id);
 	else
-		rc = iommufd_device_attach(vdev->iommufd_device, pt_id);
+		rc = iommufd_device_attach(vdev->kabi_ext->iommufd_device, pt_id);
 	if (rc)
 		return rc;
-	vdev->iommufd_attached = true;
+	vdev->kabi_ext->iommufd_attached = true;
 	return 0;
 }
 EXPORT_SYMBOL_GPL(vfio_iommufd_physical_attach_ioas);
@@ -164,11 +164,11 @@ void vfio_iommufd_physical_detach_ioas(s
 {
 	lockdep_assert_held(&vdev->dev_set->lock);
 
-	if (WARN_ON(!vdev->iommufd_device) || !vdev->iommufd_attached)
+	if (WARN_ON(!vdev->kabi_ext->iommufd_device) || !vdev->kabi_ext->iommufd_attached)
 		return;
 
-	iommufd_device_detach(vdev->iommufd_device);
-	vdev->iommufd_attached = false;
+	iommufd_device_detach(vdev->kabi_ext->iommufd_device);
+	vdev->kabi_ext->iommufd_attached = false;
 }
 EXPORT_SYMBOL_GPL(vfio_iommufd_physical_detach_ioas);
 
@@ -214,7 +214,7 @@ void vfio_iommufd_emulated_unbind(struct
 
 	if (vdev->iommufd_access) {
 		iommufd_access_destroy(vdev->iommufd_access);
-		vdev->iommufd_attached = false;
+		vdev->kabi_ext->iommufd_attached = false;
 		vdev->iommufd_access = NULL;
 	}
 }
@@ -226,13 +226,13 @@ int vfio_iommufd_emulated_attach_ioas(st
 
 	lockdep_assert_held(&vdev->dev_set->lock);
 
-	if (vdev->iommufd_attached)
+	if (vdev->kabi_ext->iommufd_attached)
 		rc = iommufd_access_replace(vdev->iommufd_access, *pt_id);
 	else
 		rc = iommufd_access_attach(vdev->iommufd_access, *pt_id);
 	if (rc)
 		return rc;
-	vdev->iommufd_attached = true;
+	vdev->kabi_ext->iommufd_attached = true;
 	return 0;
 }
 EXPORT_SYMBOL_GPL(vfio_iommufd_emulated_attach_ioas);
@@ -242,10 +242,10 @@ void vfio_iommufd_emulated_detach_ioas(s
 	lockdep_assert_held(&vdev->dev_set->lock);
 
 	if (WARN_ON(!vdev->iommufd_access) ||
-	    !vdev->iommufd_attached)
+	    !vdev->kabi_ext->iommufd_attached)
 		return;
 
 	iommufd_access_detach(vdev->iommufd_access);
-	vdev->iommufd_attached = false;
+	vdev->kabi_ext->iommufd_attached = false;
 }
 EXPORT_SYMBOL_GPL(vfio_iommufd_emulated_detach_ioas);
--- a/drivers/vfio/vfio.h
+++ b/drivers/vfio/vfio.h
@@ -83,7 +83,7 @@ struct vfio_group {
 	struct list_head		device_list;
 	struct mutex			device_lock;
 	struct list_head		vfio_next;
-#if IS_ENABLED(CONFIG_VFIO_CONTAINER)
+#if IS_ENABLED(CONFIG_VFIO_CONTAINER) || IS_ENABLED(CONFIG_IOMMUFD_VFIO_CONTAINER)
 	struct list_head		container_next;
 #endif
 	enum vfio_group_type		type;
@@ -195,7 +195,6 @@ static inline bool vfio_device_is_noiommu(struct vfio_device *vdev)
 }
 #endif /* CONFIG_VFIO_GROUP */
 
-#if IS_ENABLED(CONFIG_VFIO_CONTAINER)
 /**
  * struct vfio_iommu_driver_ops - VFIO IOMMU driver callbacks
  */
@@ -228,14 +227,17 @@ struct vfio_iommu_driver_ops {
 						   struct iommu_group *group);
 };
 
+#if IS_ENABLED(CONFIG_VFIO_CONTAINER)
 struct vfio_iommu_driver {
 	const struct vfio_iommu_driver_ops	*ops;
 	struct list_head			vfio_next;
 };
+#endif
 
 int vfio_register_iommu_driver(const struct vfio_iommu_driver_ops *ops);
 void vfio_unregister_iommu_driver(const struct vfio_iommu_driver_ops *ops);
 
+#if IS_ENABLED(CONFIG_VFIO_CONTAINER)
 struct vfio_container *vfio_container_from_file(struct file *filep);
 int vfio_group_use_container(struct vfio_group *group);
 void vfio_group_unuse_container(struct vfio_group *group);
@@ -363,7 +365,7 @@ static inline int vfio_device_add(struct vfio_device *device)
 	if (vfio_device_is_noiommu(device))
 		return device_add(&device->device);
 	vfio_init_device_cdev(device);
-	return cdev_device_add(&device->cdev, &device->device);
+	return cdev_device_add(&device->kabi_ext->cdev, &device->device);
 }
 
 static inline void vfio_device_del(struct vfio_device *device)
@@ -371,7 +373,7 @@ static inline void vfio_device_del(struct vfio_device *device)
 	if (vfio_device_is_noiommu(device))
 		device_del(&device->device);
 	else
-		cdev_device_del(&device->cdev, &device->device);
+		cdev_device_del(&device->kabi_ext->cdev, &device->device);
 }
 
 int vfio_device_fops_cdev_open(struct inode *inode, struct file *filep);
--- a/drivers/vfio/vfio_main.c
+++ b/drivers/vfio/vfio_main.c
@@ -221,9 +221,11 @@ struct vfio_device *_vfio_alloc_device(size_t size, struct device *dev,
 	if (WARN_ON(size < sizeof(struct vfio_device)))
 		return ERR_PTR(-EINVAL);
 
-	device = kvzalloc(size, GFP_KERNEL);
+	device = kvzalloc(size + sizeof(struct vfio_device_kabi_ext), GFP_KERNEL);
 	if (!device)
 		return ERR_PTR(-ENOMEM);
+	device->kabi_ext = (void *)device + size;
+	device->kabi_ext->vfio_device = device;
 
 	ret = vfio_init_device(device, dev, ops);
 	if (ret)
--- a/include/linux/vfio.h
+++ b/include/linux/vfio.h
@@ -33,6 +33,17 @@ struct vfio_device_set {
