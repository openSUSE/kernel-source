#!/bin/sh

result=0

if [ "$1" = "--no-static" ] ; then
	shift
else
	for i in $(grep -lR '^#!/usr/bin/python' scripts/alt-commits) ; do
		echo -n $i ''
		MYPYPATH=scripts/python mypy $i
		ret=$?
		if ! [ $ret -eq 0 ] ; then
			result=$ret
		fi
	done
fi

scripts/python/tests/run_all "$@"
ret=$?
if ! [ $ret -eq 0 ] ; then
	result=$ret
fi

exit $result
