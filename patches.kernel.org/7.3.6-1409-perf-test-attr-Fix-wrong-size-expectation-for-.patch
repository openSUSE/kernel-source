diff --git a/tools/perf/tests/shell/attr/test-record-dummy-C0 b/tools/perf/tests/shell/attr/test-record-dummy-C0
index 91499405fff4..54adb835d203 100644
--- a/tools/perf/tests/shell/attr/test-record-dummy-C0
