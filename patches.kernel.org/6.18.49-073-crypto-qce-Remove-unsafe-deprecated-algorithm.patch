 drivers/crypto/qce/common.c   | 55 +++++---------------
 drivers/crypto/qce/common.h   | 16 ++----
 drivers/crypto/qce/regs-v5.h  |  4 --
 drivers/crypto/qce/sha.c      | 30 +----------
 drivers/crypto/qce/sha.h      |  1 -
 drivers/crypto/qce/skcipher.c | 97 +----------------------------------
