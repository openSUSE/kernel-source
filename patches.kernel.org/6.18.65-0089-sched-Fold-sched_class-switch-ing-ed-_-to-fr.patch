 	.update_curr		= update_curr_idle,
 };
diff --git a/kernel/sched/rt.c b/kernel/sched/rt.c
index fc9737decfb7..6274bda1d570 100644
--- a/kernel/sched/rt.c
+++ b/kernel/sched/rt.c
@@ -2609,8 +2609,8 @@ DEFINE_SCHED_CLASS(rt) = {
 
 	.get_rr_interval	= get_rr_interval_rt,
 
