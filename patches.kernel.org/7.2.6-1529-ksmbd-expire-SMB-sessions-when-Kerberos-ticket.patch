 fs/smb/server/ksmbd_netlink.h     |   1 +
 fs/smb/server/ksmbd_work.h        |   1 +
 fs/smb/server/mgmt/user_session.c |  14 +-
 fs/smb/server/mgmt/user_session.h |   3 +
 fs/smb/server/server.c            |   9 +-
 fs/smb/server/smb2pdu.c           | 270 +++++++++++++++++++++---------
