 					DMERR_LIMIT("%pg: Checksum failed at sector 0x%llx",
@@ -1915,13 +1981,18 @@ static void integrity_metadata(struct work_struct *w)
 			unsigned int bi_size = dio->bio_details.bi_iter.bi_size;
