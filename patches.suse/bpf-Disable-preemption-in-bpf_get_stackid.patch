From: Jiri Olsa <jolsa@kernel.org>
Date: Mon, 3 Aug 2026 23:01:42 +0200
Subject: bpf: Disable preemption in bpf_get_stackid
Patch-mainline: v7.3-rc1
Git-commit: 15f1bd8574662f1b7b26aaa2e23ebf4066f0117d
References: CVE-2026-89799 bsc#1281137
X-Info: Cover old callchain handling path with preempt_{enable,disable}()

The get_perf_callchain call needs disabled preemption plus we need
it disabled as long as we access its returned trace entries buffer.

Note the bpf_get_stackid_pe function is executed already with
preemption disabled.

Fixes: d5a3b1f69186 ("bpf: introduce BPF_MAP_TYPE_STACK_TRACE")
Reported-by: Tao Chen <chen.dylane@linux.dev>
Signed-off-by: Jiri Olsa <jolsa@kernel.org>
Signed-off-by: Andrii Nakryiko <andrii@kernel.org>
Cc: stable@vger.kernel.org
Link: https://lore.kernel.org/bpf/20260803210149.296496-6-jolsa@kernel.org

Closes: https://lore.kernel.org/bpf/20260206090653.1336687-2-chen.dylane@linux.dev/
Acked-by: Hoyeon Lee <hoyeon.lee@suse.com>
---
 kernel/bpf/stackmap.c |   55 ++++++++++++++++++++++++++++++++++----------------
 1 file changed, 38 insertions(+), 17 deletions(-)

--- a/kernel/bpf/stackmap.c
+++ b/kernel/bpf/stackmap.c
@@ -369,26 +369,32 @@
 	bool kernel = !user;
 	u64 *ips;
 	bool hash_matches;
+	u64 ret;
 
 	if (unlikely(flags & ~(BPF_F_SKIP_FIELD_MASK | BPF_F_USER_STACK |
 			       BPF_F_FAST_STACK_CMP | BPF_F_REUSE_STACKID)))
 		return -EINVAL;
 
+	preempt_disable();
 	trace = get_perf_callchain(regs, init_nr, kernel, user,
 				   sysctl_perf_event_max_stack, false, false);
 
-	if (unlikely(!trace))
+	if (unlikely(!trace)) {
 		/* couldn't fetch the stack trace */
-		return -EFAULT;
+		ret = -EFAULT;
+		goto out;
+	}
 
 	/* get_perf_callchain() guarantees that trace->nr >= init_nr
 	 * and trace-nr <= sysctl_perf_event_max_stack, so trace_nr <= max_depth
 	 */
 	trace_nr = trace->nr - init_nr;
 
-	if (trace_nr <= skip)
+	if (trace_nr <= skip) {
 		/* skipping more than usable stack trace */
-		return -EFAULT;
+		ret = -EFAULT;
+		goto out;
+	}
 
 	trace_nr -= skip;
 	trace_len = trace_nr * sizeof(u64);
@@ -399,15 +405,19 @@
 
 	hash_matches = bucket && bucket->hash == hash;
 	/* fast cmp */
-	if (hash_matches && flags & BPF_F_FAST_STACK_CMP)
-		return id;
+	if (hash_matches && flags & BPF_F_FAST_STACK_CMP) {
+		ret = id;
+		goto out;
+	}
 
 	if (stack_map_use_build_id(map)) {
 		/* for build_id+offset, pop a bucket before slow cmp */
 		new_bucket = (struct stack_map_bucket *)
 			pcpu_freelist_pop(&smap->freelist);
-		if (unlikely(!new_bucket))
-			return -ENOMEM;
+		if (unlikely(!new_bucket)) {
+			ret = -ENOMEM;
+			goto out;
+		}
 		new_bucket->nr = trace_nr;
 		stack_map_get_build_id_offset(
 			(struct bpf_stack_build_id *)new_bucket->data,
@@ -416,23 +426,31 @@
 		if (hash_matches && bucket->nr == trace_nr &&
 		    memcmp(bucket->data, new_bucket->data, trace_len) == 0) {
 			pcpu_freelist_push(&smap->freelist, &new_bucket->fnode);
-			return id;
+			ret = id;
+			goto out;
 		}
 		if (bucket && !(flags & BPF_F_REUSE_STACKID)) {
 			pcpu_freelist_push(&smap->freelist, &new_bucket->fnode);
-			return -EEXIST;
+			ret = -EEXIST;
+			goto out;
 		}
 	} else {
 		if (hash_matches && bucket->nr == trace_nr &&
-		    memcmp(bucket->data, ips, trace_len) == 0)
-			return id;
-		if (bucket && !(flags & BPF_F_REUSE_STACKID))
-			return -EEXIST;
+		    memcmp(bucket->data, ips, trace_len) == 0) {
+			ret = id;
+			goto out;
+		}
+		if (bucket && !(flags & BPF_F_REUSE_STACKID)) {
+			ret = -EEXIST;
+			goto out;
+		}
 
 		new_bucket = (struct stack_map_bucket *)
 			pcpu_freelist_pop(&smap->freelist);
-		if (unlikely(!new_bucket))
-			return -ENOMEM;
+		if (unlikely(!new_bucket)) {
+			ret = -ENOMEM;
+			goto out;
+		}
 		memcpy(new_bucket->data, ips, trace_len);
 	}
 
@@ -442,7 +460,10 @@
 	old_bucket = xchg(&smap->buckets[id], new_bucket);
 	if (old_bucket)
 		pcpu_freelist_push(&smap->freelist, &old_bucket->fnode);
-	return id;
+	ret = id;
+out:
+	preempt_enable();
+	return ret;
 }
 
 const struct bpf_func_proto bpf_get_stackid_proto = {
