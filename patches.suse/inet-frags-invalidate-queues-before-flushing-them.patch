SL-16.1 and older: we need inet_frag_kill() to delay refcount decrement the
way it does after mainline commit eb0dfc0ef195 ("inet: frags: change
inet_frag_kill() to defer refcount updates"); rather than backporting it
and changing calls everywhere, add a patched version and use it in
fqdir_pre_exit() while keeping inet_frag_kill() functionally intact.

Fixes: 006a5035b495 ("inet: frags: flush pending skbs in fqdir_pre_exit()")
Cc: stable@vger.kernel.org
Reported-by: Kimi Security Team <bug-report@moonshot.ai>
Tested-by: Weiming Shi <shiweiming@moonshot.ai>
Reviewed-by: Eric Dumazet <edumazet@google.com>
Signed-off-by: Yilin Zhang <yilinzhang@moonshot.ai>
Link: https://patch.msgid.link/20260904162800.1095662-1-yilinzhang@moonshot.ai
Signed-off-by: Jakub Kicinski <kuba@kernel.org>
Acked-by: Michal Kubecek <mkubecek@suse.cz>

---
 net/ipv4/inet_fragment.c | 57 +++++++++++++++++++++++++---------------
 1 file changed, 36 insertions(+), 21 deletions(-)

--- a/net/ipv4/inet_fragment.c
+++ b/net/ipv4/inet_fragment.c
@@ -218,6 +218,33 @@ static int __init inet_frag_wq_init(void)
 
 pure_initcall(inet_frag_wq_init);
 
+/* equivalent of inet_frag_kill() after mainline commit eb0dfc0ef195 */
+static void __inet_frag_kill_delayed_refs(struct inet_frag_queue *fq, int *refs)
+{
+	if (del_timer(&fq->timer))
+		(*refs)++;
+
+	if (!(fq->flags & INET_FRAG_COMPLETE)) {
+		struct fqdir *fqdir = fq->fqdir;
+
+		fq->flags |= INET_FRAG_COMPLETE;
+		rcu_read_lock();
+		/* The RCU read lock provides a memory barrier
+		 * guaranteeing that if fqdir->dead is false then
+		 * the hash table destruction will not start until
+		 * after we unlock.  Paired with fqdir_pre_exit().
+		 */
+		if (!READ_ONCE(fqdir->dead)) {
+			rhashtable_remove_fast(&fqdir->rhashtable, &fq->node,
+					       fqdir->f->rhash_params);
+			(*refs)++;
+		} else {
+			fq->flags |= INET_FRAG_HASH_DEAD;
+		}
+		rcu_read_unlock();
+	}
+}
+
 void fqdir_pre_exit(struct fqdir *fqdir)
 {
 	struct inet_frag_queue *fq;
@@ -237,6 +264,8 @@ void fqdir_pre_exit(struct fqdir *fqdir)
 	rhashtable_walk_start(&hti);
 
 	while ((fq = rhashtable_walk_next(&hti))) {
+		int refs = 0;
+
 		if (IS_ERR(fq)) {
 			if (PTR_ERR(fq) != -EAGAIN)
 				break;
@@ -244,8 +273,12 @@ void fqdir_pre_exit(struct fqdir *fqdir)
 		}
 		spin_lock_bh(&fq->lock);
 		if (!(fq->flags & INET_FRAG_COMPLETE))
+			__inet_frag_kill_delayed_refs(fq, &refs);
+
+		if (fq->flags & INET_FRAG_HASH_DEAD)
 			inet_frag_queue_flush(fq, 0);
 		spin_unlock_bh(&fq->lock);
+		inet_frag_putn(fq, refs);
 	}
 
 	rhashtable_walk_stop(&hti);
@@ -262,28 +295,10 @@ EXPORT_SYMBOL(fqdir_exit);
 
 void inet_frag_kill(struct inet_frag_queue *fq)
 {
-	if (del_timer(&fq->timer))
-		refcount_dec(&fq->refcnt);
+	int refs = 0;
 
-	if (!(fq->flags & INET_FRAG_COMPLETE)) {
-		struct fqdir *fqdir = fq->fqdir;
-
-		fq->flags |= INET_FRAG_COMPLETE;
-		rcu_read_lock();
-		/* The RCU read lock provides a memory barrier
-		 * guaranteeing that if fqdir->dead is false then
-		 * the hash table destruction will not start until
-		 * after we unlock.  Paired with fqdir_pre_exit().
-		 */
-		if (!READ_ONCE(fqdir->dead)) {
-			rhashtable_remove_fast(&fqdir->rhashtable, &fq->node,
-					       fqdir->f->rhash_params);
-			refcount_dec(&fq->refcnt);
-		} else {
-			fq->flags |= INET_FRAG_HASH_DEAD;
-		}
-		rcu_read_unlock();
-	}
+	__inet_frag_kill_delayed_refs(fq, &refs);
+	inet_frag_putn(fq, refs);
 }
 EXPORT_SYMBOL(inet_frag_kill);
 
