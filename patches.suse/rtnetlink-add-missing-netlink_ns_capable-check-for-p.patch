-		err = ops->newlink(link_net ? : net, dev, tb, data, extack);
-	else
+	if (ops->newlink) {
+		if (ops->newlink_has_skb)
+			err = ops->newlink_skb(link_net ? : net, dev, tb, data,
+					       extack, skb);
+		else
+			err = ops->newlink(link_net ? : net, dev, tb, data,
+					   extack);
+	} else
 		err = register_netdevice(dev);
 	if (err < 0) {
 		free_netdev(dev);
