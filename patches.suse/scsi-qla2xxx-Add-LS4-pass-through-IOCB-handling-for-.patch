 drivers/scsi/qla2xxx/qla_isr.c  |    9 ++--
 drivers/scsi/qla2xxx/qla_nvme.c |   64 +++++++++++++++++++++++------------
 drivers/scsi/qla2xxx/qla_nvme.h |    4 +-
