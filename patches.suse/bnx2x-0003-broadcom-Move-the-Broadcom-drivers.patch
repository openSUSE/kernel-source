-		wol->supported = 0;
-		wol->wolopts = 0;
-	}
-	else {
-		wol->supported = WAKE_MAGIC;
-		if (bp->wol)
-			wol->wolopts = WAKE_MAGIC;
-		else
-			wol->wolopts = 0;
