-static inline u32 cnic_get_kcqe_layer_mask(u32 opflag)
-{
-	if (unlikely(KCQE_OPCODE(opflag) == FCOE_RAMROD_CMD_ID_TERMINATE_CONN))
-		return KCQE_FLAGS_LAYER_MASK_L4;
-
-	return opflag & KCQE_FLAGS_LAYER_MASK;
