-	while ((atomic_read(&dev->ref_count) != 0) && i < 10) {
-		msleep(100);
-		i++;
-	}
-	if (atomic_read(&dev->ref_count) != 0)
-		netdev_err(dev->netdev, "Failed waiting for ref count to go to zero\n");
