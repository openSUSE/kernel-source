-	u8 gpio_port;
-	if (CHIP_IS_E2(bp))
-		gpio_port = BP_PATH(bp);
-	else
-		gpio_port = params->port;
-	DP(NETIF_MSG_LINK, "Setting 8073 port %d into low power mode\n",
-	   gpio_port);
-	bnx2x_set_gpio(bp, MISC_REGISTERS_GPIO_2,
