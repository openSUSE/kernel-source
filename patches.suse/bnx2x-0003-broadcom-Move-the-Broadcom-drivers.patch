-static void
-bnx2_disable_int_sync(struct bnx2 *bp)
-{
-	int i;
-
-	atomic_inc(&bp->intr_sem);
-	if (!netif_running(bp->dev))
-		return;
-
-	bnx2_disable_int(bp);
-	for (i = 0; i < bp->irq_nvecs; i++)
-		synchronize_irq(bp->irq_tbl[i].vector);
-}
