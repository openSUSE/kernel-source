-
-		if (test_bit(CNIC_LCL_FL_L2_WAIT, &cp->cnic_local_flags))
-			netdev_err(dev->netdev,
-				"iSCSI CLIENT_HALT did not complete\n");
-		cnic_spq_completion(dev, DRV_CTL_RET_L2_SPQ_CREDIT_CMD, 1);
