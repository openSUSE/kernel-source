-static void
-bnx2_init_tx_context(struct bnx2 *bp, u32 cid, struct bnx2_tx_ring_info *txr)
-{
-	u32 val, offset0, offset1, offset2, offset3;
-	u32 cid_addr = GET_CID_ADDR(cid);
