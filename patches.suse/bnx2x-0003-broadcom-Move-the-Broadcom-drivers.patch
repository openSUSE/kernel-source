-static int
-bnx2_set_pauseparam(struct net_device *dev, struct ethtool_pauseparam *epause)
-{
-	struct bnx2 *bp = netdev_priv(dev);
-
-	bp->req_flow_ctrl = 0;
-	if (epause->rx_pause)
-		bp->req_flow_ctrl |= FLOW_CTRL_RX;
-	if (epause->tx_pause)
-		bp->req_flow_ctrl |= FLOW_CTRL_TX;
-
-	if (epause->autoneg) {
-		bp->autoneg |= AUTONEG_FLOW_CTRL;
-	}
-	else {
-		bp->autoneg &= ~AUTONEG_FLOW_CTRL;
-	}
