-#define CL22_WR_OVER_CL45(_bp, _phy, _bank, _addr, _val) \
-	bnx2x_cl45_write(_bp, _phy, \
-		(_phy)->def_md_devad, \
-		(_bank + (_addr & 0xf)), \
-		_val)
-
-#define CL22_RD_OVER_CL45(_bp, _phy, _bank, _addr, _val) \
