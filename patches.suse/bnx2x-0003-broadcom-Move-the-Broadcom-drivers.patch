-
-	if (CHIP_IS_E3(bp)) {
-		struct bnx2x_phy *phy = &params->phy[INT_PHY];
-		bnx2x_set_aer_mmd(params, phy);
-		bnx2x_check_over_curr(params, vars);
-		bnx2x_warpcore_config_runtime(phy, params, vars);
-	}
