-	bnx2_read_phy(bp, bp->mii_up1, &up1);
-	if (!(up1 & BCM5708S_UP1_2G5)) {
-		up1 |= BCM5708S_UP1_2G5;
-		bnx2_write_phy(bp, bp->mii_up1, up1);
-		ret = 0;
-	}
-
-	if (CHIP_NUM(bp) == CHIP_NUM_5709)
-		bnx2_write_phy(bp, MII_BNX2_BLK_ADDR,
-			       MII_BNX2_BLK_ADDR_COMBO_IEEEB0);
