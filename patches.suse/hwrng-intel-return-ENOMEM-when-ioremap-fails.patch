From 4c3ca7c8c152278332590bfd3df1b0f086364759 Mon Sep 17 00:00:00 2001
From: Thorsten Blum <blum@kernel.org>
Date: Tue, 22 Sep 2026 20:11:01 +0200
Subject: hwrng: intel - return -ENOMEM when ioremap() fails
Git-commit: 4c3ca7c8c152278332590bfd3df1b0f086364759
Patch-mainline: v7.4-rc1
References: git-fixes

intel_init_hw_struct() incorrectly returns -EBUSY when ioremap() fails.
Return -ENOMEM instead.

Fixes: c24c95a085c6 ("[PATCH] fix Intel RNG detection")
Signed-off-by: Thorsten Blum <blum@kernel.org>
Signed-off-by: Herbert Xu <herbert@gondor.apana.org.au>
Acked-by: Takashi Iwai <tiwai@suse.de>

---
 drivers/char/hw_random/intel-rng.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/char/hw_random/intel-rng.c b/drivers/char/hw_random/intel-rng.c
index 5da06ed79e2d..bc4aa9ea1195 100644
--- a/drivers/char/hw_random/intel-rng.c
+++ b/drivers/char/hw_random/intel-rng.c
@@ -318,8 +318,8 @@ static int __init intel_init_hw_struct(struct intel_rng_hw *intel_rng_hw,
 	}
 
 	intel_rng_hw->mem = ioremap(INTEL_FWH_ADDR, INTEL_FWH_ADDR_LEN);
-	if (intel_rng_hw->mem == NULL)
-		return -EBUSY;
+	if (!intel_rng_hw->mem)
+		return -ENOMEM;
 
 	return 0;
 }
-- 
