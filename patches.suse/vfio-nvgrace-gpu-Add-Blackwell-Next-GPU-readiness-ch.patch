 include/uapi/linux/pci_regs.h       |    1 
 2 files changed, 151 insertions(+), 12 deletions(-)

--- a/drivers/vfio/pci/nvgrace-gpu/main.c
+++ b/drivers/vfio/pci/nvgrace-gpu/main.c
@@ -3,10 +3,13 @@
