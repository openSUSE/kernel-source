Acked-by: Hoyeon Lee <hoyeon.lee@suse.com>
---
 kernel/bpf/cgroup.c |    1 +
 1 file changed, 1 insertion(+)

--- a/kernel/bpf/cgroup.c
+++ b/kernel/bpf/cgroup.c
@@ -2163,6 +2163,7 @@
 		return -E2BIG;
 
 	memcpy(ctx->new_val, buf, buf_len);
+	((char *)ctx->new_val)[buf_len] = '\0';
 	ctx->new_len = buf_len;
 	ctx->new_updated = 1;
 
