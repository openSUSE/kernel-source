-			&buf[24], &tmp_tid_len, &iport_ptr);
+			&buf[24], tid_len, &tmp_tid_len, &iport_ptr);
 	if (!initiator_str) {
 		pr_err("SPC-3 PR REGISTER_AND_MOVE: Unable to locate"
 			" initiator_str from Transport ID\n");
