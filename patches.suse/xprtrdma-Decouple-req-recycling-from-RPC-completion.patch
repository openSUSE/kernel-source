 }
 
@@ -775,7 +772,6 @@ static bool rpcrdma_prepare_readch(struc
 		len -= len & 3;
 		if (!rpcrdma_prepare_tail_iov(req, xdr, page_base, len))
 			return false;
-		kref_get(&req->rl_kref);
 	}
 
 	return true;
@@ -804,7 +800,6 @@ inline int rpcrdma_prepare_send_sges(str
 		goto out_nosc;
