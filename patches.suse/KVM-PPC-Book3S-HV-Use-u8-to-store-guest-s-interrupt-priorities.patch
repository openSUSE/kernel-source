From 0e3d5c0408262aef599df888e9bde88d0337c1dc Mon Sep 17 00:00:00 2001
From: Gautam Menghani <gautam@linux.ibm.com>
Date: Fri, 6 Nov 2026 13:37:42 +0530
Subject: KVM: PPC: Book3S HV: Use u8 to store guest's interrupt priorities

References: bsc#1215199
Patch-mainline: v7.4-rc4
Git-commit: 0e3d5c0408262aef599df888e9bde88d0337c1dc

Interrupt priorities range from 0x00 - 0xFF. When represented as u32 by
the host in kvm_rtas_set_xive(), the guest can pass in a higher priority
number (eg: 0x1FF) which ends up breaking this check in
kvmppc_xive_set_xive():

        if (priority != MASKED) {
                mutex_lock(&xive->lock);
                rc = xive_check_provisioning(xive->kvm,
                              xive_prio_from_guest(priority));
                mutex_unlock(&xive->lock);
        }

This results in an attempt to access invalid memory in the function
xive_provision_queue():

        struct xive_q *q =  &xc->queues[prio]; // prio = 0xFF

Fix this by converting the priority variable to u8.

Fixes: 5af50993850a ("KVM: PPC: Book3S HV: Native usage of the XIVE interrupt controller")
Tested-by: R Nageswara Sastry <rnsastry@linux.ibm.com>
Reviewed-by: Shrikanth Hegde <sshegde@linux.ibm.com>
Signed-off-by: Gautam Menghani <gautam@linux.ibm.com>
Signed-off-by: Madhavan Srinivasan <maddy@linux.ibm.com>
Acked-by: Michal Suchanek <msuchanek@suse.de>
---
 arch/powerpc/include/asm/kvm_ppc.h | 4 ++--
 arch/powerpc/kvm/book3s_rtas.c     | 5 +++--
 arch/powerpc/kvm/book3s_xive.c     | 2 +-
 3 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/arch/powerpc/include/asm/kvm_ppc.h b/arch/powerpc/include/asm/kvm_ppc.h
index 169ea6a7fbad..0b85c13baf28 100644
--- a/arch/powerpc/include/asm/kvm_ppc.h
+++ b/arch/powerpc/include/asm/kvm_ppc.h
@@ -720,7 +720,7 @@ static inline int kvmppc_xive_xics_hcall(struct kvm_vcpu *vcpu, u32 req)
  * new "XIVE" interrupt controller.
  */
 extern int kvmppc_xive_set_xive(struct kvm *kvm, u32 irq, u32 server,
-				u32 priority);
+				u8 priority);
 extern int kvmppc_xive_get_xive(struct kvm *kvm, u32 irq, u32 *server,
 				u32 *priority);
 extern int kvmppc_xive_int_on(struct kvm *kvm, u32 irq);
@@ -758,7 +758,7 @@ extern bool kvmppc_xive_native_supported(void);
 
 #else
 static inline int kvmppc_xive_set_xive(struct kvm *kvm, u32 irq, u32 server,
-				       u32 priority) { return -1; }
+				       u8 priority) { return -1; }
 static inline int kvmppc_xive_get_xive(struct kvm *kvm, u32 irq, u32 *server,
 				       u32 *priority) { return -1; }
 static inline int kvmppc_xive_int_on(struct kvm *kvm, u32 irq) { return -1; }
diff --git a/arch/powerpc/kvm/book3s_rtas.c b/arch/powerpc/kvm/book3s_rtas.c
index 0507715d0fdd..125e06d99884 100644
--- a/arch/powerpc/kvm/book3s_rtas.c
+++ b/arch/powerpc/kvm/book3s_rtas.c
@@ -18,7 +18,8 @@
 #ifdef CONFIG_KVM_XICS
 static void kvm_rtas_set_xive(struct kvm_vcpu *vcpu, struct rtas_args *args)
 {
-	u32 irq, server, priority;
+	u32 irq, server;
+	u8 priority;
 	int rc;
 
 	if (be32_to_cpu(args->nargs) != 3 || be32_to_cpu(args->nret) != 1) {
@@ -28,7 +29,7 @@ static void kvm_rtas_set_xive(struct kvm_vcpu *vcpu, struct rtas_args *args)
 
 	irq = be32_to_cpu(args->args[0]);
 	server = be32_to_cpu(args->args[1]);
-	priority = be32_to_cpu(args->args[2]);
+	priority = (u8) be32_to_cpu(args->args[2]);
 
 	if (xics_on_xive())
 		rc = kvmppc_xive_set_xive(vcpu->kvm, irq, server, priority);
diff --git a/arch/powerpc/kvm/book3s_xive.c b/arch/powerpc/kvm/book3s_xive.c
index 9d2039ee37b2..00218a7dc688 100644
--- a/arch/powerpc/kvm/book3s_xive.c
+++ b/arch/powerpc/kvm/book3s_xive.c
@@ -1267,7 +1267,7 @@ static int xive_target_interrupt(struct kvm *kvm,
  */
 
 int kvmppc_xive_set_xive(struct kvm *kvm, u32 irq, u32 server,
-			 u32 priority)
+			 u8 priority)
 {
 	struct kvmppc_xive *xive = kvm->arch.xive;
 	struct kvmppc_xive_src_block *sb;
-- 
