From: Yang Xiuwei <yangxiuwei@kylinos.cn>
Date: Mon, 20 Jul 2026 14:03:05 +0800
Subject: nvme/ioctl: check SUBMIT_IO with nvme_cmd_allowed()
Git-commit: b53d495c7f0db46b6748b5ade48371a10dd5d3bc
Patch-mainline: v7.3-rc1
References: bsc#1281705 CVE-2026-90227

Unlike IO_CMD / IO64_CMD, NVME_IOCTL_SUBMIT_IO never calls
nvme_cmd_allowed(). Unprivileged callers can thus issue I/O on a
partition device or write through a read-only file descriptor.

Pass flags and open_for_write through and reject disallowed commands
with -EACCES.

Reviewed-by: Christoph Hellwig <hch@lst.de>
Signed-off-by: Yang Xiuwei <yangxiuwei@kylinos.cn>
Signed-off-by: Keith Busch <kbusch@kernel.org>
Acked-by: Nikolay Borisov <nik.borisov@suse.com>
---
 drivers/nvme/host/core.c |    9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

--- a/drivers/nvme/host/core.c
+++ b/drivers/nvme/host/core.c
@@ -1232,7 +1232,8 @@ static void nvme_enable_aen(struct nvme_
 			 supported_aens);
 }
 
-static int nvme_submit_io(struct nvme_ns *ns, struct nvme_user_io __user *uio)
+static int nvme_submit_io(struct nvme_ns *ns, struct nvme_user_io __user *uio,
+			  fmode_t mode)
 {
 	struct nvme_user_io io;
 	struct nvme_command c;
@@ -1277,6 +1278,10 @@ static int nvme_submit_io(struct nvme_ns
 	c.rw.apptag = cpu_to_le16(io.apptag);
 	c.rw.appmask = cpu_to_le16(io.appmask);
 
+	if (!nvme_cmd_allowed(ns, &c, mode))
+		return -EACCES;
+
+
 	return nvme_submit_user_cmd(ns->queue, &c,
 			(void __user *)(uintptr_t)io.addr, length,
 			metadata, meta_len, lower_32_bits(io.slba), NULL, 0);
@@ -1450,7 +1455,7 @@ static int nvme_ns_ioctl(struct nvme_ns
 	case NVME_IOCTL_IO_CMD:
 		return nvme_user_cmd(ns->ctrl, ns, (void __user *)arg, mode);
 	case NVME_IOCTL_SUBMIT_IO:
-		return nvme_submit_io(ns, (void __user *)arg);
+		return nvme_submit_io(ns, (void __user *)arg, mode);
 	default:
 		if (ns->ndev)
 			return nvme_nvm_ioctl(ns, cmd, arg);
