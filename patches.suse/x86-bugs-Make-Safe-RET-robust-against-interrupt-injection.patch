 arch/x86/kernel/cpu/bugs.c           |   39 +++++++++++++++++++++++
 arch/x86/kernel/relocate_kernel_64.S |    6 +--
 arch/x86/lib/retpoline.S             |   19 +++++++++++
 6 files changed, 128 insertions(+), 7 deletions(-)

