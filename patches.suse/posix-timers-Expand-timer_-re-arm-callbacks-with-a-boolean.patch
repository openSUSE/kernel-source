+++ b/kernel/time/posix-timers.c
@@ -240,12 +240,13 @@ static inline int timer_overrun_to_int(s
 	return sum > (s64)INT_MAX ? INT_MAX : (int)sum;
 }
 
-static void common_hrtimer_rearm(struct k_itimer *timr)
