From 93cfc00d61933e1506a6fee3ab16a0d128fe500b Mon Sep 17 00:00:00 2001
From: Jiri Wiesner <jwiesner@suse.de>
Date: Mon, 5 Oct 2026 12:10:27 +0200
Subject: Revert ibmvnic patches causing SAP HANA TSM Backup regression
Patch-mainline: Never, workaround for firmware bug
References: bsc#1261816

The patches being reverted were identified with a bisection. The patches
change the way packet descriptors are prepared by the ibmvnic driver. Some
older firmware versions flashed on ibmvnic NICs, such as the ones on Power
9 machines, start dropping packets when TCP starts sending data out in
bulk. Since SUSE has no knowledge of the assumptions that the firmware
makes about packet descriptors, the best way forward is to revert the
patches and let IBM fix the issue.

This patch reverts these upstream patches:
* d95f749a0b5e42a30d7025d19c15a11c1a570e72
("ibmvnic: Reduce memcpys in tx descriptor generation").
* b41b45ecee6ba74bd590b113be9f349c6b818b46
("ibmvnic: Use header len helper functions on tx").
The patches were merged into v6.12-rc1. The reason for not reverting the 
patches separetely that is the kernel with just the second one is buggy - 
TCP does do not work.

Signed-off-by: Jiri Wiesner <jwiesner@suse.de>
---
 drivers/net/ethernet/ibm/ibmvnic.c | 96 +++++++++++++++++-------------
 1 file changed, 56 insertions(+), 40 deletions(-)

diff --git a/drivers/net/ethernet/ibm/ibmvnic.c b/drivers/net/ethernet/ibm/ibmvnic.c
index e6c3d10ed917c..fc5ff1bea245c 100644
--- a/drivers/net/ethernet/ibm/ibmvnic.c
+++ b/drivers/net/ethernet/ibm/ibmvnic.c
@@ -2160,49 +2160,63 @@ static int ibmvnic_close(struct net_device *netdev)
 }
 
 /**
- * get_hdr_lens - fills list of L2/L3/L4 hdr lens
+ * build_hdr_data - creates L2/L3/L4 header data buffer
  * @hdr_field: bitfield determining needed headers
  * @skb: socket buffer
- * @hdr_len: array of header lengths to be filled
+ * @hdr_len: array of header lengths
+ * @hdr_data: buffer to write the header to
  *
  * Reads hdr_field to determine which headers are needed by firmware.
  * Builds a buffer containing these headers.  Saves individual header
  * lengths and total buffer length to be used to build descriptors.
- *
- * Return: total len of all headers
  */
-static int get_hdr_lens(u8 hdr_field, struct sk_buff *skb,
-			int *hdr_len)
+static int build_hdr_data(u8 hdr_field, struct sk_buff *skb,
+			  int *hdr_len, u8 *hdr_data)
 {
 	int len = 0;
+	u8 *hdr;
 
-
-	if ((hdr_field >> 6) & 1) {
-		hdr_len[0] = skb_mac_header_len(skb);
-		len += hdr_len[0];
-	}
-
-	if ((hdr_field >> 5) & 1) {
-		hdr_len[1] = skb_network_header_len(skb);
-		len += hdr_len[1];
-	}
-
-	if (!((hdr_field >> 4) & 1))
-		return len;
+	if (skb_vlan_tagged(skb) && !skb_vlan_tag_present(skb))
+		hdr_len[0] = sizeof(struct vlan_ethhdr);
+	else
+		hdr_len[0] = sizeof(struct ethhdr);
 
 	if (skb->protocol == htons(ETH_P_IP)) {
+		hdr_len[1] = ip_hdr(skb)->ihl * 4;
 		if (ip_hdr(skb)->protocol == IPPROTO_TCP)
 			hdr_len[2] = tcp_hdrlen(skb);
 		else if (ip_hdr(skb)->protocol == IPPROTO_UDP)
 			hdr_len[2] = sizeof(struct udphdr);
 	} else if (skb->protocol == htons(ETH_P_IPV6)) {
+		hdr_len[1] = sizeof(struct ipv6hdr);
 		if (ipv6_hdr(skb)->nexthdr == IPPROTO_TCP)
 			hdr_len[2] = tcp_hdrlen(skb);
 		else if (ipv6_hdr(skb)->nexthdr == IPPROTO_UDP)
 			hdr_len[2] = sizeof(struct udphdr);
+	} else if (skb->protocol == htons(ETH_P_ARP)) {
+		hdr_len[1] = arp_hdr_len(skb->dev);
+		hdr_len[2] = 0;
 	}
 
-	return len + hdr_len[2];
+	memset(hdr_data, 0, 120);
+	if ((hdr_field >> 6) & 1) {
+		hdr = skb_mac_header(skb);
+		memcpy(hdr_data, hdr, hdr_len[0]);
+		len += hdr_len[0];
+	}
+
+	if ((hdr_field >> 5) & 1) {
+		hdr = skb_network_header(skb);
+		memcpy(hdr_data + len, hdr, hdr_len[1]);
+		len += hdr_len[1];
+	}
+
+	if ((hdr_field >> 4) & 1) {
+		hdr = skb_transport_header(skb);
+		memcpy(hdr_data + len, hdr, hdr_len[2]);
+		len += hdr_len[2];
+	}
+	return len;
 }
 
 /**
@@ -2215,14 +2229,12 @@ static int get_hdr_lens(u8 hdr_field, struct sk_buff *skb,
  *
  * Creates header and, if needed, header extension descriptors and
  * places them in a descriptor array, scrq_arr
- *
- * Return: Number of header descs
  */
 
 static int create_hdr_descs(u8 hdr_field, u8 *hdr_data, int len, int *hdr_len,
 			    union sub_crq *scrq_arr)
 {
-	union sub_crq *hdr_desc;
+	union sub_crq hdr_desc;
 	int tmp_len = len;
 	int num_descs = 0;
 	u8 *data, *cur;
@@ -2231,26 +2243,28 @@ static int create_hdr_descs(u8 hdr_field, u8 *hdr_data, int len, int *hdr_len,
 	while (tmp_len > 0) {
 		cur = hdr_data + len - tmp_len;
 
-		hdr_desc = &scrq_arr[num_descs];
-		if (num_descs) {
-			data = hdr_desc->hdr_ext.data;
+		memset(&hdr_desc, 0, sizeof(hdr_desc));
+		if (cur != hdr_data) {
+			data = hdr_desc.hdr_ext.data;
 			tmp = tmp_len > 29 ? 29 : tmp_len;
-			hdr_desc->hdr_ext.first = IBMVNIC_CRQ_CMD;
-			hdr_desc->hdr_ext.type = IBMVNIC_HDR_EXT_DESC;
-			hdr_desc->hdr_ext.len = tmp;
+			hdr_desc.hdr_ext.first = IBMVNIC_CRQ_CMD;
+			hdr_desc.hdr_ext.type = IBMVNIC_HDR_EXT_DESC;
+			hdr_desc.hdr_ext.len = tmp;
 		} else {
-			data = hdr_desc->hdr.data;
+			data = hdr_desc.hdr.data;
 			tmp = tmp_len > 24 ? 24 : tmp_len;
-			hdr_desc->hdr.first = IBMVNIC_CRQ_CMD;
-			hdr_desc->hdr.type = IBMVNIC_HDR_DESC;
-			hdr_desc->hdr.len = tmp;
-			hdr_desc->hdr.l2_len = (u8)hdr_len[0];
-			hdr_desc->hdr.l3_len = cpu_to_be16((u16)hdr_len[1]);
-			hdr_desc->hdr.l4_len = (u8)hdr_len[2];
-			hdr_desc->hdr.flag = hdr_field << 1;
+			hdr_desc.hdr.first = IBMVNIC_CRQ_CMD;
+			hdr_desc.hdr.type = IBMVNIC_HDR_DESC;
+			hdr_desc.hdr.len = tmp;
+			hdr_desc.hdr.l2_len = (u8)hdr_len[0];
+			hdr_desc.hdr.l3_len = cpu_to_be16((u16)hdr_len[1]);
+			hdr_desc.hdr.l4_len = (u8)hdr_len[2];
+			hdr_desc.hdr.flag = hdr_field << 1;
 		}
 		memcpy(data, cur, tmp);
 		tmp_len -= tmp;
+		*scrq_arr = hdr_desc;
+		scrq_arr++;
 		num_descs++;
 	}
 
@@ -2273,11 +2287,13 @@ static void build_hdr_descs_arr(struct sk_buff *skb,
 				int *num_entries, u8 hdr_field)
 {
 	int hdr_len[3] = {0, 0, 0};
+	u8 hdr_data[140] = {0};
 	int tot_len;
 
-	tot_len = get_hdr_lens(hdr_field, skb, hdr_len);
-	*num_entries += create_hdr_descs(hdr_field, skb_mac_header(skb),
-					 tot_len, hdr_len, indir_arr + 1);
+	tot_len = build_hdr_data(hdr_field, skb, hdr_len,
+				 hdr_data);
+	*num_entries += create_hdr_descs(hdr_field, hdr_data, tot_len, hdr_len,
+					 indir_arr + 1);
 }
 
 static int ibmvnic_xmit_workarounds(struct sk_buff *skb,
