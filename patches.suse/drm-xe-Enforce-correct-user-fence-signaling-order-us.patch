 drivers/gpu/drm/xe/xe_exec_queue_types.h |    7 ++++
 drivers/gpu/drm/xe/xe_oa.c               |   45 ++++++++++++++++++++-----------
 drivers/gpu/drm/xe/xe_oa_types.h         |    8 +++++
