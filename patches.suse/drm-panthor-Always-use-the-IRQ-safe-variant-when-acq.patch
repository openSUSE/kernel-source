 		}
-		spin_unlock(&queue->fence_ctx.lock);
 
 		/* Manually update the syncobj seqno to unblock waiters. */
 		syncobj = group->syncobjs->kmap + (i * sizeof(*syncobj));
@@ -3047,39 +3043,39 @@ static bool queue_check_job_completion(s
 	LIST_HEAD(done_jobs);
 
