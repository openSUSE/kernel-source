#!/bin/bash

# Find depending commits for the given sha to be applied on top
# of the given base. Focus only on changes that might help to
# deal with conflicts presented in the reject file if provided
# Prints shas of dependant commits
#
# Usage
# scripts/sha2deps sha branch [dir_with_rejects reject_files]
#
. $(dirname "$0")/common-functions


fail()
{
	echo $@ >&2
	exit 1
}

blame_rejects()
{
	local sha=$1
	local rej_dir="$2"
	local f=
	shift 2

	for f in "$@"
	do
		local reject_file="$rej_dir/$f"
		local git_f="${f%.rej}"
		local match=
		grep -n '^@@' "$reject_file" | while read -r match;
		do
			local hunk_header=$(echo "$match" | cut -d: -f2-)

			# Extract original file line range: -<start>,<count>
			# Note: Handles both '-45,10' and single-line '-45' formats
			local old_range=$(echo "$hunk_header" | sed -E 's/.*-([0-9]+)(,([0-9]+))?.*/\1 \3/')
			local start_line=$(echo "$old_range" | awk '{print $1}')
			local count=$(echo "$old_range" | awk '{print $2}')

			# Default count to 1 if omitted
			[ -z "$count" ] && count=1

			end_line=$((start_line + count - 1))
			git -C $LINUX_GIT blame -L "${start_line},+${count}" --porcelain $sha~ -- "$git_f" 2>/dev/null | grep -E '^[0-9a-f]{40}' | awk '{print $1}'
		done
	done | sort -u
}

sha_is_breaker()
{
	local sha=$1
	local dep=$2
	local f=

	for f in $(sha_get_upstream_git_fixes $sha)
	do
		local full_f="$(git -C $LINUX_GIT rev-parse $f 2>/dev/null)"
		[ "$dep" != "$full_f" ] && continue
		echo "$f is breaker. Partial backport"
		return 0
	done

	return 1
}

sha=$1
sha_in_upstream "$sha" || fail "$sha not a sha"

cd $KSOURCE_GIT
branch="${2#origin/}"
base=$(branch_base_ver "$branch")

shift 2
if [ $# -eq 0 ]
then
	# Git history method
	files="$(git -C $LINUX_GIT show --pretty="" --name-only "$sha")"
	for f in $files
	do
		mapfile -t funs < <(git -C $LINUX_GIT show -U0 $sha -- $f | grep "^@@" | sed -n 's#^@@.*@@ .*\b\([A-Za-z_][A-Za-z0-9_]*\)\s*(.*#-L:\1:'$f'#p' | sort -u)
	done

	echo "Looking for ${funs[@]}" >&2

	# -L (hiding in funs) ignores --pretty="format:%H so we need to grep the sha out"
	for s in $(git -C $LINUX_GIT --no-pager log "${funs[@]}" ^$base $sha~ | grep -E '^commit [0-9a-f]{40}' | cut -d" " -f2)
	do
		# Already backport
		sha_merged_in_suse_tree $s $branch && continue
		sha_is_breaker $sha $s && continue
		echo $s
	done
else
	# Git blame method just from reject files
	rej_dir=$1
	shift
	for s in $(blame_rejects $sha "$rej_dir" "$@")
	do
		sha_merged_in_upstream_tag $s $base && continue
		sha_merged_in_suse_tree $s $branch && continue
		sha_is_breaker $sha $s && continue
		echo $s
	done
fi

