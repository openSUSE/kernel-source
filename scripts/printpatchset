#!/usr/bin/ruby

require 'optparse'
require 'open3'
require 'set'

$fixes = false
$reference = true
$upstream = true
$commit = true

OptionParser.new{|opts|
  opts.banner = "Usage: #{$0} [options] [branch|patch ...]"
  opts.separator ""
  opts.on("-f", "--[no-]fixes", "Group patches by fixes (default #{$fixes})"){|f|
    $fixes = f
  }
  opts.on("-r", "--[no-]reference", "Print reference (default #{$reference})"){|r|
    $reference = r
  }
  opts.on("-u", "--[no-]upstream", "Print upstream version (default #{$upstream})"){|u|
    $upstream = u
  }
  opts.on("-c", "--[no-]commit", "Print commit sha (default #{$commit})"){|c|
    $commit = c
  }
  opts.on_tail("-h", "--help", "Show this message"){
    puts opts
    exit
  }
}.parse!

ARGV.push '@{U}' if ARGV.length == 0

patches = []

$seen = Set[]

_, status = Open3.capture2e('git', 'show', ARGV[0], '--pretty=oneline')

if status == 0 then
  output, _ = Open3.capture2('git', 'diff', ARGV[0], 'series.conf')
  $all_patches = patches = output.lines.select{|x| (x =~ /^[+][^+]/) and (x !~ /#/) and x.length > 5}.map{|x| x.sub(/^[+]/, '').strip}
else
  if ARGV[0] =~ /#/ then
    $all_patches = File.readlines('series.conf').map(&:strip).map(&:chomp)
    output, _ = Open3.capture2('git', 'grep', '-l', ARGV[0], 'patches.suse')
    patchset = output.lines.map(&:chomp).to_set
    patches = $all_patches.select{|x| patchset.include? x}
  else
    patches = ARGV
  end
end

def print_patch patch, level = 0
  prefix = ''
  prefix = '   ' * level + 'Fixed-by: ' if level > 0
  subj, _ = Open3.capture2('grep', '-i', 'Subject: ', patch) rescue nil
  subj = subj.split[1..-1].join(' ').sub(/\[PATCH[^\]]*\] */, '')
  pl = "#{subj}"
  ref, _ = Open3.capture2('grep', '-i', 'References: ', patch)
  ref = ref.split[1..-1].join(' ') rescue nil
  commit, _ = Open3.capture2('grep', '-i', 'Git-commit: ', patch)
  commit = commit.split[1..-1].join(' ') rescue nil
  if commit and commit.length > 0 then
    pl = "#{ref} #{pl}" if $reference
    ver, _ = Open3.capture2('grep', '-i', 'Patch-mainline: v', patch)
    ver = ver.split[1..-1].join(' ') rescue nil
    pl = "#{ver} #{pl}" if $upstream
    pl = "#{commit} #{pl}" if $commit
    if not $seen.include? commit then
      puts "#{prefix}#{pl}"
      if $fixes then
        $seen.add(commit)
        fixes = "Fixes: #{commit[0...12]}"
        output, _ = Open3.capture2('git', 'grep', '-l', fixes)
        fixes = output.lines.map(&:chomp)
        fixset = fixes.to_set
        fixes = $all_patches.select{|x| fixset.include? x}
        fixes.each{|f| print_patch f, level + 1}
      end
    end
  else
    ml, _ = Open3.capture2('grep', '-i', 'Patch-mainline: ', patch)
    ml = ml.strip
    pl = "#{ml} #{pl}" if $upstream
    pl = "#{ref} #{pl}" if $reference
    puts pl
  end
end


patches.each{|patch|
  print_patch patch
}
