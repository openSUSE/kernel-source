#!/usr/bin/env bash
# fetch-todo-cves — Fetch CVE related c-k-f output files from our remote worker.
#
# Requires rank_order_cves.py deployed on the source host.
#
# The remote username defaults to the local $USER. If your account name on
# the remote host (LDAP) differs, override it with KSS_REMOTE_USER

set -eu

SRC_HOST="kss.prg2.suse.org"
SRC_USER="${KSS_REMOTE_USER:-$USER}"
SCANNER_PATH="/usr/local/bin/cve-reserve"

MODE=""            # "local" or "ls"
LOCAL_DIR=""
FILE_COUNT=10
REVERSE_FLAG=""
WONT_FIX_FLAG=""

CVE_ARGS=()
EMAIL_ARGS=()
SUBSYSTEM_ARGS=()

SSH_COMMON="-o StrictHostKeyChecking=accept-new -o ConnectTimeout=30"

src_ssh() { ssh $SSH_COMMON "${SRC_USER}@${SRC_HOST}" "$@"; }
src_scp() { scp $SSH_COMMON "$@"; }

die() { echo "ERROR: $*" >&2; exit 1; }

show_help() {
    cat << EOF

$(basename "$0") — Fetch CVE c-k-f files from ${SRC_HOST}.

Modes:
  -d, --dest <dir>    Reserve the top N matching files on the remote
                      (isolate) and download them to a local directory
  --ls                List matching files on the remote without moving them

Options:
  -n <num>            Number of files to fetch or list (default: 10)
  -h, --help          Show this message

Environment:
  KSS_REMOTE_USER     Username on the remote host, if it differs from your
                      local \$USER (e.g. your LDAP account name).

All other options are passed through to ${SCANNER_PATH}
on ${SRC_HOST}. Its help follows:

EOF
    local remote_help
    if remote_help=$(src_ssh "$(printf '%q ' "$SCANNER_PATH" --help)"); then
        # Skip the remote header (everything before "options:") and the
        # options the wrapper handles itself.
        printf '%s\n' "$remote_help" \
            | sed -n '/^options:/,$p' \
            | grep -vE '^  (-h, --help|-n N|--ls|--isolate) ' || true
    else
        echo "(Could not fetch remote help from ${SRC_HOST}.)" >&2
    fi
    exit 0
}

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)      show_help ;;
        --ls)           MODE="ls"; shift ;;
        -d|--dest)      MODE="local"; LOCAL_DIR="${2:-}"; shift; [[ $# -gt 0 ]] && shift ;;
        -n)             FILE_COUNT="$2"; shift 2 ;;
        --reverse)      REVERSE_FLAG="--reverse"; shift ;;
        --wont-fix)     WONT_FIX_FLAG="--wont-fix"; shift ;;
        --ai-rank)      echo "WARNING: --ai-rank is deprecated and ignored." >&2; shift ;;
        -c|--cve)
            shift
            while [[ $# -gt 0 && "$1" != -* ]]; do
                CVE_ARGS+=("$1")
                shift
            done
            ;;
        -e|--email)
            shift
            while [[ $# -gt 0 && "$1" != -* ]]; do
                EMAIL_ARGS+=("$1")
                shift
            done
            ;;
        -s|--subsystem)
            shift
            while [[ $# -gt 0 && "$1" != -* ]]; do
                SUBSYSTEM_ARGS+=("$1")
                shift
            done
            ;;
        *)
            echo "Unknown option: $1" >&2
            echo "Run '$(basename "$0") --help' for usage." >&2
            exit 1 ;;
    esac
done

[[ -n "$MODE" ]] || die "You must specify a mode: -d/--dest <dir> or --ls."

if [[ "$MODE" == "local" ]]; then
    [[ -n "$LOCAL_DIR" ]] || die "-d/--dest requires a directory argument."
    [[ -d "$LOCAL_DIR" ]] || die "Local directory does not exist: $LOCAL_DIR"
fi

# Build filter args as an array so multi-word values stay intact
FILTER_ARGS=()
if [[ ${#CVE_ARGS[@]} -gt 0 ]]; then
    FILTER_ARGS+=( -c "${CVE_ARGS[@]}" )
fi
if [[ ${#EMAIL_ARGS[@]} -gt 0 ]]; then
    FILTER_ARGS+=( -e "${EMAIL_ARGS[@]}" )
fi
if [[ ${#SUBSYSTEM_ARGS[@]} -gt 0 ]]; then
    FILTER_ARGS+=( -s "${SUBSYSTEM_ARGS[@]}" )
fi

# Assemble the remote argv and escape it so the REMOTE shell re-parses it correctly
build_remote_cmd() {
    local mode_flag="$1"          # --ls or --isolate
    local -a argv=( "$SCANNER_PATH" -n "$FILE_COUNT" "$mode_flag" )
    if [[ -n "$REVERSE_FLAG" ]]; then argv+=( "$REVERSE_FLAG" ); fi
    if [[ -n "$WONT_FIX_FLAG" ]]; then argv+=( "$WONT_FIX_FLAG" ); fi
    if [[ ${#FILTER_ARGS[@]} -gt 0 ]]; then argv+=( "${FILTER_ARGS[@]}" ); fi
    printf '%q ' "${argv[@]}"
}

if [[ "$MODE" == "ls" ]]; then
    src_ssh "$(build_remote_cmd --ls)"
    exit 0
fi

# ──────────────────────────────────────────────
# Transfer
# ──────────────────────────────────────────────
# 1. Isolate files on source to prevent races
if [[ ${#CVE_ARGS[@]} -gt 0 ]]; then
    echo "Scanning and isolating files for ${#CVE_ARGS[@]} requested CVE(s) on ${SRC_HOST}..."
else
    echo "Scanning and isolating up to ${FILE_COUNT} file(s) on ${SRC_HOST}..."
fi
REMOTE_OUTPUT=$(src_ssh "$(build_remote_cmd --isolate)")

ISOLATED_DIR=$(echo "$REMOTE_OUTPUT" | grep "^ISOLATED_DIR:" | cut -d':' -f2- || true)
[[ -n "$ISOLATED_DIR" ]] || die "Failed to get processing directory from source."

mapfile -t FILES < <(echo "$REMOTE_OUTPUT" | grep -v "^ISOLATED_DIR:" | grep -v "^SRC_DIR:" | grep -v '^$' || true)

if [[ ${#FILES[@]} -eq 0 ]]; then
    echo "No files matched the criteria."
    exit 0
fi

echo "Isolated ${#FILES[@]} file(s) in ${ISOLATED_DIR} on ${SRC_HOST}."

# 2. Download directly into the destination directory
echo "Downloading from ${SRC_HOST} to ${LOCAL_DIR}..."
if ! src_scp "${SRC_USER}@${SRC_HOST}:${ISOLATED_DIR}/*" "${LOCAL_DIR}/"; then
    echo "Download failed. Files remain isolated on source at: ${ISOLATED_DIR}" >&2
    exit 1
fi

echo "Copied ${#FILES[@]} file(s) to ${LOCAL_DIR}."

# 3. Summary — isolated dir is preserved on source
echo ""
echo "Isolated files preserved on ${SRC_HOST} at: ${ISOLATED_DIR}"
echo "Done. ${#FILES[@]} file(s) transferred: ${SRC_HOST} -> ${LOCAL_DIR}"
