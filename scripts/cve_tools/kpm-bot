#!/bin/bash

# Pull in env
[ -f ~/.kpm-bot.rc ] && . ~/.kpm-bot.rc
: ${KPM_BRANCH_USER:="kpm"}
: ${KPM_BUGZILLA_USER:="cve-kpm@suse.de"}

PROCESS_DIR=~/kpm.queue
[ -d $PROCESS_DIR ] || mkdir $PROCESS_DIR

LOG=~/kpm.log
KSS_DASHBOARD='./scripts/cve_tools/kss-dashboard'
LOCK_FILE=$PROCESS_DIR/.lock

exec {LOCK_FD}>$LOCK_FILE

exec > >(tee -a $LOG) 2>&1
shopt -s nullglob

fix_merged()
{
	local branch="$1"
	local cve="$2"
	local sha

	git grep -qi "^references:.*$cve\>" $branch && return 0
	for sha in $(cve2sha "$cve")
	do
		git grep -qi "^git-commit:.*$sha" $branch && return 0
	done

	return 1
}

cve_blacklisted()
{
	local branch="$1"
	local cve="$2"

	git grep -iq "$cve" $branch -- blacklist.conf
}

fetch_external_sources()
{
	echo "== Fetch external sources"
	(echo "Fetch $LINUX_GIT" ; cd $LINUX_GIT; git fetch origin)
	(echo "Pulling $VULNS_GIT" ; cd $VULNS_GIT; git pull origin)
}

update_incoming_queue()
{
	echo "== Update incoming queue"
	local cve
	for cve in $(scripts/bugzilla-list-user-bugs $KPM_BUGZILLA_USER | sed 's@.*; VUL.*: \(CVE-.*\): kernel.*@\1@')
	do
		# CVEs not belonging to kernel CNA will produce empty action file
		# check_incoming_queue will take care of those but $CVE.in.done
		# will be empty as well so test -f rather than -s for done files
		[ -s $PROCESS_DIR/${cve}.in -o -f $PROCESS_DIR/${cve}.in.done ] && continue
		echo "Unseen $cve. Assess target branches"
		./scripts/check-kernel-fix -n $cve 2>/dev/null | grep ": MANUAL:" | cut -d: -f1 > $PROCESS_DIR/${cve}.in
	done
}

apply_patch()
{
	local cve=$1
	local user_branch=$2
	shift 2

	echo "Trying to apply cleanly $@"
	./scripts/sequence-patch -d /dev/shm/kpm --rapid > $cve.log 2>&1
	local succ=$?
	local TREE="$(grep "^\[ Tree:" $cve.log | sed 's@^\[ Tree:\(.*\) \]$@\1@')"

	if [ $succ -ne 0 ]
	then
		for fuzz in 1 2 3
		do
			echo "Trying to apply with fuzz $fuzz"
			./scripts/sequence-patch --fuzz=$fuzz -d /dev/shm/kpm --rapid > $cve.log 2>&1
			succ=$?
			if [ $succ -eq 0 ]
			then
				local patch
				for patch in $@
				do
					./scripts/sequence-patch --fuzz=$fuzz -d /dev/shm/kpm --rapid $patch > $cve.log 2>&1 
					(
						cd $TREE; QUILT_PATCH_ARGS="--no-backup-if-mismatch" quilt push --fuzz=$fuzz;
						succ=$?
						./refresh_patch; rm $(quilt top)~
						exit $succ
					)
					succ=$?
					[ $suc -gt 0 ] && break
				done

				if [ $succ -eq 0 ]
				then
					echo "$user_branch applies with fuzz=$fuzz" >> $PROCESS_DIR/$cve.warn
					break
				fi
			fi
		done
	fi

	rm $cve.log
	[ -d $TREE ] && rm -rf $TREE

	return $succ
}
check_incoming_queue()
{
	echo "== Check incoming queue"
	local cve_file
	for cve_file in $PROCESS_DIR/*.in
	do
		if [ ! -s "$cve_file" ]
		then
			mv $cve_file $cve_file.done
			continue
		fi

		local cve="$(basename $cve_file .in)"
		local temp_failure=0
		echo "=== $cve_file"
		for target_branch in $(cat $cve_file)
		do
			if fix_merged origin/$target_branch $cve
			then
				echo "Fix merged in origin/$target_branch"
				continue
			fi
			if cve_blacklisted origin/$target_branch $cve
			then
				echo "$cve blacklisted in origin/$target_branch"
				continue
			fi

			local user_branch="users/${KPM_BRANCH_USER}/$target_branch/$cve"
			if [ -s $PROCESS_DIR/${cve}.failed ]
			then
				grep -q "^$target_branch" $PROCESS_DIR/${cve}.failed && continue
			fi

			if [ $target_branch = "SLE11-SP4-LTSS" ]
			then
				echo "$target_branch doesn't support sorted section. Skipping"
				echo "$target_branch doesn't support sorted section. Skipping" >> $PROCESS_DIR/${cve}.failed
				continue
			fi
			if ! git checkout -b $user_branch origin/$target_branch 2>/dev/null
			then
				if fix_merged $user_branch $cve
				then
					grep -q $user_branch $PROCESS_DIR/${cve}.build 2>/dev/null || echo $user_branch >> $PROCESS_DIR/${cve}.build
					continue
				fi

				echo "$user_branch exists without a fix. Recreating"
				git checkout $user_branch
				git reset --hard origin/$target_branch
			fi

			# kss-dashboard doesn't report errors of some tools like insert_patch
			if ! $KSS_DASHBOARD -V $cve -1
			then
				git checkout $FALLBACK_BRANCH >/dev/null 2>&1
				git branch -D $user_branch
				temp_failure=1
				continue
			fi
			local patch_files="$(git diff -- series.conf | awk '/^+[[:space:]].*patches\./{print $2}')"
			
			if [ -z "$patch_files" ]
			then
				echo "No patch added!"
				git reset --hard
				git checkout $FALLBACK_BRANCH >/dev/null 2>&1
				git branch -D $user_branch
				temp_failure=1
				continue
			fi

			if ! apply_patch $cve $user_branch $patch_files
			then
				git reset --hard
				rm $patch_files
				echo $user_branch failed to apply
				echo "$target_branch failed to apply" >> $PROCESS_DIR/${cve}.failed
				git checkout $FALLBACK_BRANCH >/dev/null 2>&1
				git branch -D $user_branch
				continue
			fi

			git add $patch_files
			if ! ./scripts/log --no-edit
			then
				git reset --hard
				rm $patch_files
				echo "$target_branch failed to pass commit hooks" >> $PROCESS_DIR/${cve}.failed
				git checkout $FALLBACK_BRANCH >/dev/null 2>&1
				git branch -D $user_branch
				continue
			fi

			# If fails then build phase will retry
			git push origin $user_branch
			echo $user_branch >> $PROCESS_DIR/${cve}.build
		done

		[ $temp_failure -gt 0 ] && continue

		# Do not overwrite previous state
		cat $cve_file >> $cve_file.done
		rm $cve_file

		# Nothing pushed and all failed to apply
		if [ ! -s "$PROCESS_DIR/${cve}.build" ] && cmp "$PROCESS_DIR/${cve}.in.done" "$PROCESS_DIR/${cve}.failed" > /dev/null
		then
			local bugzilla_file=$PROCESS_DIR/$cve.bugzilla
			echo "Fix failed to cleanly apply to all actionable branches:" > $bugzilla_file
			cat $PROCESS_DIR/${cve}.failed >> $bugzilla_file

		fi
	done
}

process_kbuild_report()
{
	local branch="$1"

	ssh kerncvs.suse.de "grep -l \"^Subject: $branch\" -r /srv/kbuild/mail-sent/ | xargs cat 2>/dev/null" | awk \
'/^\[ /{
	arch=$2
	failed=0
	warn=0
}
arch && /^[:space:]*$/{
	arch=0
	next
}
/^Checking warnings.*FAIL/{
	if (!warn_reported)
		warn=1
	warn_reported=1
	printf "'$branch' %s new warnings\n", arch
	next
}
arch && warn && /warning: /{
	printf "'$branch' %s", $0
}'
}

check_build_queue()
{
	echo "== Check build status"
	local build_file
	for build_file in $PROCESS_DIR/*.build
	do
		[ ! -s "$build_file" ] && continue

		cve="$(basename $build_file .build)"

		local pending=0
		local existing_pr=0
		local failed=""
		local ready=""
		echo "=== $cve"
		for branch in $(cat $build_file)
		do
			branch_head="$(git rev-parse $branch 2>/dev/null)"
			if [ $? -gt 0 ]
			then
				echo "$branch does not exist"
				continue
			fi

			base_branch="$(echo $branch | sed "s@users/${KPM_BRANCH_USER}/\(.*\)/$cve@\1@")"

			if ! fix_merged $branch $cve
			then
				echo "$branch doesn't contain fixes for cve. Retrying"
				echo $base_branch >> $PROCESS_DIR/${cve}.in
				pending=1
				continue
			fi

			if fix_merged origin/$base_branch $cve
			then
				echo "Fix merged for $cve"
				continue
			fi
			if cve_blacklisted origin/$base_branch $cve
			then
				echo "$cve blacklisted in origin/$target_branch"
				continue
			fi

			let existing_pr++
			if ! git rev-parse origin/$branch >/dev/null 2>&1
			then
				# Should not happen but should be recoverable
				pending=1
				echo $branch not pushed. Pushing now
				git push origin $branch
				continue
			fi

			build_status="$(check_build_status "origin/$branch")"
			local build_ret=$?
			echo "$branch build status: $build_status"
			if [ $build_ret -eq 2 ]
			then
				pending=1
				continue
			elif [ $build_ret -eq 1 ]
			then
				echo "$branch failed through kbuild tests"
				git push origin :$branch
				git branch -D $branch
				echo "$base_branch failed through kbuild tests" >> $PROCESS_DIR/${cve}.failed
			else
				ready="$ready $branch"
				process_kbuild_report "$branch" >> $PROCESS_DIR/$cve.warn
			fi
		done

		[ $pending -eq 1 ] && continue
		if [ $existing_pr -eq 0 ]
		then
			# Nothing left to do
			cat $PROCESS_DIR/${cve}.build >> $PROCESS_DIR/${cve}.build.done
			rm $PROCESS_DIR/${cve}.build
			continue
		fi

		local bugzilla_file=$PROCESS_DIR/$cve.bugzilla
		if [ -n "$ready" ]
		then
			echo "Fix for $cve apply cleanly and pass build test in:" > $bugzilla_file
			for user_branch in $ready
			do
				echo "$user_branch"
				if [ -s $PROCESS_DIR/$cve.warn ]
				then
					grep "$user_branch" $PROCESS_DIR/$cve.warn | sed "s@$user_branch@\t@"
				fi 
			done >> $bugzilla_file
			echo "You can pull from these branches, review the outcome and add your" >> $bugzilla_file
			echo -e "Reviewed-by before sending a PR.\n" >> $bugzilla_file
		fi
		if [ -s "$PROCESS_DIR/${cve}.failed" ]
		then
			echo "Fix for $cve FAILS for following branches:" >> $bugzilla_file
			cat "$PROCESS_DIR/${cve}.failed" >> $bugzilla_file
		fi

		cat $PROCESS_DIR/${cve}.build >> $PROCESS_DIR/${cve}.build.done
		rm $PROCESS_DIR/${cve}.build
	done
}

update_bugzilla()
{
	local update_bugzilla="$1"
	local bugzilla_file

	echo "== Handle bugzilla files $update_bugzilla"
	for bugzilla_file in $PROCESS_DIR/*.bugzilla
	do
		[ -s "$bugzilla_file" ] || continue

		local cve="$(basename $bugzilla_file .bugzilla)"

		# Only update bugzilla if this is still on kpm queue
		local assignee="$(scripts/python/get-bugzilla-metadata -f assignee $cve)"
		if [[ ! $assignee =~ $KPM_BUGZILLA_USER ]]
		then
			echo "$cve not assigned to $KPM_BUGZILLA_USER anymore. Skipping bugzilla update"
			mv $bugzilla_file $bugzilla_file.done
			continue
		fi

		if [ "$update_bugzilla" -eq 1 ]
		then
			echo "=== Updating bug for $cve"
			scripts/python/modify-bugs -f $bugzilla_file -V $cve && mv $bugzilla_file $bugzilla_file.done
		else
			echo "=== Content for $cve bug"
			cat $bugzilla_file
		fi
	done
}

do_branch_cleanup()
{
	echo "== Branch clean up"
	local branch
	for branch in $(git branch -l "users/${KPM_BRANCH_USER}/*/CVE*" | sed "s@.*\(users.*\)@\1@")
	do
		local cve=${branch##*/}
		local base_branch="$(echo $branch | sed "s@users/${KPM_BRANCH_USER}/\(.*\)/$cve@\1@")"
		echo "Checking $branch"
		if ! fix_merged origin/$base_branch $cve
		then
			cve_blacklisted origin/$base_branch $cve || continue
			echo -n "$cve blacklisted in origin/$base_branch."
		else
			echo -n "Fix for $cve merged into origin/$base_branch."
		fi
		echo " Removing $branch"
		git push origin :$branch 2>/dev/null
		git branch -D $branch
	done 
}

show_status()
{
	echo "== Queus status"
	echo -n "Number of cves under evaluation "
	ls -l $PROCESS_DIR/*.in 2>/dev/null | wc -l

	echo -n "Number of branches waiting for build test "
	grep . $PROCESS_DIR/*.build 2>/dev/null | wc -l

	echo -n "Number of bugzilla files waiting for dispatching "
	ls -l $PROCESS_DIR/*.bugzilla 2>/dev/null | wc -l

	echo -n "Number of CVE branches "
	git -C $KSOURCE_GIT branch -l users/${KPM_BRANCH_USER}/*/CVE* 2>/dev/null | wc -l
}

usage()
{
	cat << EOF
Script to process trivial patch queue

Usage:
	kpm-bot [{update_,process_}in_queue|build_queue|bugzilla|update_bugzilla|cleanup|status]

Executes the full pipeline without any arguments. If at least one argument
is provided only executes named parts of the pipeline:
	- update_in_queue - fetches new CVEs assigned to $KPM_BUGZILLA_USER user
	  and create CVE.in file with branches requiting the backport. Skips through
	  CVEs with existing .in[.done] files 
	- process_in_queue - applies the fix for each branch in CVE.in files and
	  push successfully created branches (users/$KPM_BRANCH_USER/prod/CVE) for
	  build test (note all those into CVE.done file)
	- in_queue - shortcut for update_in_queue & process_in_queue
	- build_queue - checks the build queue (CVE.build files) and check
	  their build status. Push a local branch if it is not pushed yet.
	- bugzilla - displays generated bugzilla files (CVE.bugzilla)
	- update_bugzilla - updates bugzilla with generated files (archive
	  them to CVE.bugzilla.done)
	- cleanup - cleans up created files (i.e. drop branches with fix
	  already merged).
	- status - displays the current status of the in/build/bugzilla queues.
	  Only executed when explicitly called.
EOF
	exit 0
}

echo "= Run $(date) $@"

full_mode=1
update_in_queue=0
process_in_queue=0
build_queue=0
bugzilla=0
cleanup=0
update_bugzilla=0
stat=0
while [ $# -gt 0 ]
do
	case "$1" in
		in_queue ) update_in_queue=1 ; process_in_queue=1;;
		update_in_queue ) update_in_queue=1 ;;
		process_in_queue ) process_in_queue=1 ;;
		build_queue ) build_queue=1;;
		bugzilla ) bugzilla=1;;
		update_bugzilla ) bugzilla=1;update_bugzilla=1;;
		cleanup ) cleanup=1 ;;
		status ) stat=1 ;;
		* ) usage ;;
	esac
	shift
	full_mode=0
done

# unconditional
cd $KSOURCE_GIT
echo "Fetch $KSOURCE_GIT"
git fetch origin
. scripts/common-functions

(
	# Lock operations which potentially modify local state
	if ! flock -n $LOCK_FD
	then
		echo "Backing off on $LOCK_FILE"
		echo "= Done"
		exit 0
	else
		echo "Locking $LOCK_FILE"
	fi
	if [ $full_mode -eq 1 -o $update_in_queue -eq 1 -o $process_in_queue -eq 1 ]
	then
		FALLBACK_BRANCH="$(git symbolic-ref --short HEAD 2>/dev/null)"
		fetch_external_sources
		[ $full_mode -eq 1 -o $update_in_queue -eq 1 ] && update_incoming_queue
		[ $full_mode -eq 1 -o $process_in_queue -eq 1 ] && check_incoming_queue
		git checkout $FALLBACK_BRANCH >/dev/null 2>&1
	fi

	[ $full_mode -eq 1 -o $build_queue -eq 1 ] && check_build_queue
	[ $full_mode -eq 1 -o $bugzilla -eq 1 ] && update_bugzilla $update_bugzilla
	[ $full_mode -eq 1 -o $cleanup -eq 1 ] && do_branch_cleanup
)

# This one doesn't need any locking
[ $stat -eq 1 ] && show_status
echo "= Done"
