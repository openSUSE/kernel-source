#!/bin/bash
#
# blacklist-cve - manage CVE blacklist requests on the automation host.
#
# This is a thin wrapper around the automation tool, which runs on a remote
# host as an SSH forced command.
#
# The remote username defaults to the local $USER. If your account name on
# the remote host (LDAP) differs, override it with KSS_REMOTE_USER
set -euo pipefail

HOST="${KSS_REMOTE_USER:-$USER}@kss.prg2.suse.org"

# The automation script on the remote host. We name it explicitly so this works
# for BOTH kinds of access:
#   - keys pinned to a forced command
#   - normal login shells (no forced command): the remote shell needs the real
#     command to run, so it must be named here
REMOTE_CMD="/app/blacklist/scripts/req-job"

prog=$(basename "$0")

usage() {
    cat <<EOF
$prog - manage CVE blacklist requests.

Usage:
  $prog [add] <CVE ID> <branches> <bz_ref> [sha]
  $prog rm   <CVE|request filename>
  $prog show [--mine] [--user <name>] [--pending|--completed] [CVE|request filename]
  $prog -h | --help

Requests are queued, not applied immediately: a job runs once a week and
processes everything in the queue. Until then a request stays pending
(see '$prog show --pending').

Commands:
  [add]  Submit a new blacklist request. ('add' is the default and can be omitted)
           CVE ID     e.g. CVE-2025-1234
           branches   e.g. SLE15-SP6-LTSS,SL-16.0
           bz_ref     Bugzilla comment, e.g. 1234567#c1 or a full URL
           sha        (Optional) upstream commit hash (short or full)
                      This should be used for CVEs with multiple fixes
                      when there are different BZ comments for each fix

  rm     Remove a pending request you own.

  show   List requests. With no filter, shows everything.
           --mine          only your requests
           --user <name>   only that user's requests
           --pending       only pending requests
           --completed     only completed (processed or rejected) requests

Environment:
  KSS_REMOTE_USER   Username on the remote host, if it differs from your
                    local \$USER (e.g. your LDAP account name).

Examples:
  # Submit a request
  $prog CVE-2025-1234 SLE15-SP6-LTSS 1234567#c1
  $prog add CVE-2025-1234 SLE15-SP6-LTSS 1234567#c1

  # Submit a request with the optional SHA at the end
  $prog CVE-2025-1234 SLE15-SP6-LTSS 1234567#c1 f95d186255b

  # Remove a pending request
  $prog rm CVE-2025-1234
  $prog rm blacklist_CVE-2025-1234_2h71yi8j.req

  # List your requests / only pending / a specific CVE
  $prog show --mine
  $prog show --pending
  $prog show CVE-2025-1234

  # Use a different username on the remote host
  KSS_REMOTE_USER=jdoe $prog show --mine
EOF
}

handle_add() {
    if [ "$#" -eq 3 ]; then
        CVE="$1"
        BRANCHES="$2"
        BZ_REF="$3"
        exec ssh -t "$HOST" "$REMOTE_CMD" blacklist add "$CVE" "$BRANCHES" "$BZ_REF"
    elif [ "$#" -eq 4 ]; then
        CVE="$1"
        BRANCHES="$2"
        BZ_REF="$3"
        SHA="$4"
        exec ssh -t "$HOST" "$REMOTE_CMD" blacklist add "$CVE" "$BRANCHES" "$BZ_REF" -s "$SHA"
    else
        echo "Error: 'add' expects 3 or 4 arguments: <CVE> <branches> <bz_ref> [sha], got $#." >&2
        echo "Run '$prog --help' for usage and examples." >&2
        exit 1
    fi
}

handle_rm() {
    if [ "$#" -ne 1 ]; then
        echo "Error: 'rm' expects 1 argument (CVE, id, or filename), got $#." >&2
        echo "Run '$prog --help' for usage." >&2
        exit 1
    fi
    exec ssh -t "$HOST" "$REMOTE_CMD" blacklist rm "$@"
}

handle_show() {
    exec ssh "$HOST" "$REMOTE_CMD" blacklist show "$@"
}

cmd=${1:-}
case "$cmd" in
    -h|--help)
        usage
        exit 0
        ;;
    "")
        usage >&2
        exit 1
        ;;
    rm)
        shift
        handle_rm "$@"
        ;;
    show)
        shift
        handle_show "$@"
        ;;
    add)
        shift
        handle_add "$@"
        ;;
    *)
        # default to add. Do not shift so the CVE is preserved as the first argument
        handle_add "$@"
        ;;
esac
