#!/bin/bash
# ANSI Color Variables (enable only on supported terms)
GREEN=""
CYAN=""
YELLOW=""
RED=""
NC=""
if [ -t 1 ] && command -v tput >/dev/null 2>&1; then
    if [ "$(tput colors 2>/dev/null)" -ge 8 ]; then
        GREEN="$(tput setaf 2)"
        CYAN="$(tput setaf 6)"
        YELLOW="$(tput setaf 3)"
        RED="$(tput setaf 1)"
        NC="$(tput sgr0)" # No color
    fi
fi

export PATH=/sbin:/usr/sbin:/bin:/usr/bin

echo -e "${CYAN}====================================================${NC}"
echo -e "${CYAN}    kbox - Fast Boot Dracut+Native Sandbox Initialization${NC}"
echo -e "${CYAN}====================================================${NC}"

echo -n "Mounting API filesystems... "
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /dev/shm

mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run

# create the dirs Zypper needs
mkdir -p /var/tmp /var/cache/zypp /var/log/zypp /var/lib/zypp /var/run
echo -e "[ ${GREEN}OK${NC} ]"

echo -n "Loading kernel modules manually... "
for mod in virtio_pci virtio_console virtio_net 9pnet_virtio 9p virtio_rng; do
    modprobe $mod >/dev/null 2>&1 || true
done
echo -e "[ ${GREEN}OK${NC} ]"

# Bring up network
echo -e "Initializing loopback and network interfaces..."
ip link set lo up
ip link set eth0 up

echo -n "Requesting DHCP lease for eth0... "
if busybox udhcpc -i eth0 -n -t 5 -q >/dev/null 2>&1; then
    echo -e "[ ${GREEN}OK${NC} ]"
elif dhclient -1 -q eth0 >/dev/null 2>&1; then
    echo -e "[ ${GREEN}OK${NC} ]"
else
    echo -e "[ ${RED}FAILED${NC} ]"
fi
cat > /etc/resolv.conf << 'RES_EOF'
nameserver 10.0.2.3
nameserver 8.8.8.8
RES_EOF

mkdir -p /mnt/workspace
if mount -t 9p -o trans=virtio,version=9p2000.L,msize=10485760 host_mount /mnt/workspace 2>/dev/null; then
    echo -e "Mounting 9p Host Passthrough... [ ${GREEN}OK${NC} ]"
else
    echo -e "Mounting 9p Host Passthrough... [ ${RED}FAILED${NC} ]"
fi

echo -e "Setting up SSH Server in background... "
mkdir -p /var/run/sshd /etc/ssh /var/lib/empty
if ! grep -q "^sshd:" /etc/group 2>/dev/null; then
    echo "sshd:x:74:" >> /etc/group
fi
if ! grep -q "^sshd:" /etc/passwd 2>/dev/null; then
    echo "sshd:x:74:74:Privilege-separated SSH:/var/lib/empty:/sbin/nologin" >> /etc/passwd
fi

if [ -x /usr/sbin/sshd ]; then
    (
        ssh-keygen -A >/dev/null 2>&1
        cat > /etc/ssh/sshd_config << "SSH_EOF"
Port 22
PermitRootLogin yes
PermitEmptyPasswords yes
UsePAM no
HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ecdsa_key
HostKey /etc/ssh/ssh_host_ed25519_key
Subsystem sftp internal-sftp
SSH_EOF
        # passwd -d root >/dev/null 2>&1
        sed -i 's/^root:[^:]*:/root::/' /etc/shadow 2>/dev/null || true
        /usr/sbin/sshd
    ) &
    echo -e "[ ${GREEN}STARTED ASYNC${NC} ]"
else
    echo -e "[ ${RED}FAILED - sshd missing${NC} ]"
fi

# Ensure RPM database is cached properly
# rpm --rebuilddb >/dev/null 2>&1 || true


sed -i 's|/bin/sh|/bin/bash|g' /etc/passwd
sed -i 's|/root:|/mnt/workspace:|g' /etc/passwd

cat > /etc/profile << "PROFILE_EOF"

GREEN=""
CYAN=""
YELLOW=""
NC=""
if [ -t 1 ] && command -v tput >/dev/null 2>&1; then
    if [ "$(tput colors 2>/dev/null)" -ge 8 ]; then
        GREEN="$(tput setaf 2)"
        CYAN="$(tput setaf 6)"
        YELLOW="$(tput setaf 3)"
        NC="$(tput sgr0)"
    fi
fi
export PS1="kernel-sandbox:\w# "
cd /mnt/workspace 2>/dev/null

echo ""
echo -e "${GREEN}Sandbox environment (DRACUT mode) active. Dropping to a root shell.${NC}"
echo -e "${CYAN}Current directory: $(pwd)${NC}"
echo -e "${CYAN}====================================================${NC}"
echo -e "${YELLOW} [ENVIRONMENT NOTICE]:${NC}"
echo -e "  * This is a ${YELLOW}DRACUT-BASED${NC} testing sandbox."
echo -e "  * Native package utilities (${GREEN}zypper, rpm, vim${NC}) ARE present."
echo -e "  * Network is ${GREEN}Functional${NC} with internet access."
echo -e "  * SSH is ${GREEN}Active${NC}. Connect via: ssh -p 2222 root@localhost"
echo -e "  * ${CYAN}WORKSPACE MAPPING:${NC}"
echo -e "    The /mnt/workspace directory is bound to the isolated host worktree:"
echo -e "    ${GREEN}{{HOST_WORKSPACE_PATH}}${NC}"
echo -e "    (Modifications here will be reflected on your host's WORKSPACE MAPPING)"
echo -e "    (Modifications here will NOT affect your host's active CWD)"
echo -e "  * For full fledged VM sandbox environment, terminate"
echo -e "    execution and relaunch the sandbox script with: ${GREEN}kernel-sandbox --mode rpm${NC}"
echo -e "${CYAN}====================================================${NC}"
echo ""
PROFILE_EOF

# setsid -c -w bash --login < /dev/ttyS0 > /dev/ttyS0 2>&1
setsid -c -w bash --login

# Instantly kill QEMU when the shell exits
echo -e "${YELLOW}Shutting down sandbox instantly...${NC}"
echo 1 > /proc/sys/kernel/sysrq
echo o > /proc/sysrq-trigger
poweroff -f
