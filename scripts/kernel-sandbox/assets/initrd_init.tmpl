#!/bin/sh
# ANSI Color Variables (enable only on supported terms)
GREEN=""
CYAN=""
YELLOW=""
RED=""
NC=""
# busybox has no tput/ncurses. we can safely fallback to ANSI only (basic 8 colors scheme) if stdout is a TTY.
# qemu-console char stream takes us to TERM=linux
if [ -t 1 ]; then
    case "$TERM" in
        linux|xterm*)
            GREEN="\033[0;32m"
            CYAN="\033[0;36m"
            YELLOW="\033[1;33m"
            RED="\033[0;31m"
            NC="\033[0m"
            ;;
    esac
fi

echo -e "${CYAN}====================================================${NC}"
echo -e "${CYAN}    kbox - Fast Boot Minimal Kernel Sandbox Initialization${NC}"
echo -e "${CYAN}====================================================${NC}"

# Mount essential filesystems
echo -n "Mounting API filesystems... "
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev && echo -e "[ ${GREEN}OK${NC} ]"

# Bring up network
echo -e "Initializing loopback and network interfaces..."
cat > /etc/resolv.conf << 'EOF'
nameserver 10.0.2.3
EOF
ip link set lo up
ip link set eth0 up

# Trigger DHCP client asynchronously or synchronously
echo -e "${YELLOW}Requesting IP address via DHCP...${NC}"
udhcpc -i eth0 -n -q

# Mount 9p shared workspace if available
if grep -q host_mount /proc/mounts 2>/dev/null;
then
    echo -e "${YELLOW}9p mount already present.${NC}"
else
    mkdir -p /mnt/workspace
    if mount -t 9p -o trans=virtio,version=9p2000.L host_mount /mnt/workspace 2>/dev/null;
    then
        echo -e "Mounting 9p Host Passthrough... [ ${GREEN}OK${NC} ]"
        echo -e "${GREEN}Workspace cleanly attached at /mnt/workspace${NC}"
    else
        echo -e "Mounting 9p Host Passthrough... [ ${RED}FAILED${NC} ]"
        echo -e "${RED}Warning: Build tree assets will not be visible under /mnt/workspace${NC}"
    fi
fi

# Change working directory to the shared host mount point
if [ -d /mnt/workspace ];
then
    cd /mnt/workspace
fi

# Drop cleanly to shell
echo ""
echo -e "${GREEN}Sandbox environment(INITRD mode) active. Dropping to a root sh engine.${NC}"
echo -e "${CYAN}Current directory: $(pwd)${NC}"
echo -e "${CYAN}====================================================${NC}"
echo -e "${YELLOW} [ENVIRONMENT NOTICE]:${NC}"
echo -e "  * This is a ${YELLOW}MINIMAL${NC} testing sandbox driven strictly by BUSYBOX."
echo -e "  * Native package configuration utilities like ${RED}zypper${NC} are NOT present."
echo -e "  * Additional testing dependencies can be extracted manually using:"
echo -e "    BUSYBOX micro-utilities: ${GREEN}rpm -i package_name.rpm${NC}"
echo -e "  * Network is ${GREEN}Functional${NC} with internet access."
echo -e "  * ${CYAN}WORKSPACE MAPPING:${NC}"
echo -e "    The /mnt/workspace directory is bound to the isolated host worktree:"
echo -e "    ${GREEN}{{HOST_WORKSPACE_PATH}}${NC}"
echo -e "    (Modifications here will be reflected on your host's WORKSPACE MAPPING)"
echo -e "    (Modifications here will NOT affect your host's active CWD)"
echo -e "  * For full fledged VM sandbox environment, terminate"
echo -e "    execution and relaunch the sandbox script with: ${GREEN}kernel-sandbox --mode rpm${NC}"
echo -e "${CYAN}====================================================${NC}"
echo ""

# cttyhack automatically discovers the overwise active serial terminal device (ex: /dev/ttyS0),
# binds it as a true controlling TTY, and enables hardware job signals (Ctrl+C)
exec setsid cttyhack sh