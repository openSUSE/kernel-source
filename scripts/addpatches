#!/bin/sh

dir="patches.suse"
force_add=false
reference=""
refresh_bigmem=false

usage() {
	cat << EOF
Add patches to kernel-source
usage: $0 [-f] [-r reference] [-k] [-b] [-d directory] patch ...

	-f	force adding already present patch
	-r	instead of sorting patch add after reference in series.conf
	-k	add kabi patch ( -d patches.kabi -r patches.kabi )
	-b	refresh bigmem patch
	-d	add to directory other than patches.suse
EOF
}

while getopts "hfr:kbd:" OPT
do
	case $OPT in
		'?')
			echo
			usage
			exit 1
			;;
		h)
			usage
			exit
			;;
		f)
			force_add=true
			;;
		r)
			reference="$OPTARG"
			;;
		k)
			dir="patches.kabi"
			reference="patches.kabi"
			;;
		b)
			refresh_bigmem=true
			;;
		d)
			dir="$OPTARG"
			;;
	esac
done

while [ -n "$1" ] ; do
	patchfile="$(basename "$1")"
	patchtgt="$(echo "$patchfile" | sed -e 's/^[0-9]\+-//')"
	tgt="$dir/$patchtgt"
	if ! [ -f $tgt ] || $force_add ; then
		patch_present=false
		[ -f $tgt ] && patch_present=true
		cp "$1" "$tgt"
		git add "$tgt"
		if [ -z "${reference}" -a -x scripts/git_sort/series_insert ] ; then
			echo -ne $tgt "\r"
			scripts/git_sort/series_insert $tgt || $patch_present || exit 1
		else
			echo -e "/${reference}/p\n/^\$/i\n\t${tgt}\n.\nw\nq" | ed series.conf
		fi
		git add series.conf
	else
		echo $tgt already present.
		diff -u $1 $tgt
	fi
	if $refresh_bigmem && [ -x scripts/bigmem-generate-ifdef-guard ] ; then
		scripts/bigmem-generate-ifdef-guard && git add patches.suse/ppc64-bigmem-introduce-CONFIG_BIGMEM
		scripts/log
	fi
	shift
done
