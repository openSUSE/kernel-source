class Workers:
    """Isolated, picklable multiprocessing task handlers."""

    @staticmethod
    def fetch_commit_metadata(args: Tuple[str, List[str]]) -> Dict[str, CommitInfo]:
        """Worker function: Stream author, dates, subject, body, and modified files for a chunk of SHAs."""
        repo_path, shas = args
        input_shas = "\n".join(shas) + "\n"

        sha_to_info = {}
        cmd = [
            "git",
            "--no-pager",
            "log",
            "-z",
            "--ignore-missing",
            "--no-walk",
            "--no-merges",
            "--stdin",
            "--name-only",
            "--format=%H%n%an%n%at%n%ct%n%s%n%b%x01",
        ]
        proc = subprocess.Popen(
            cmd,
            cwd=repo_path,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            bufsize=1024 * 1024,
        )
        try:
            proc.stdin.write(input_shas.encode("utf-8"))
            proc.stdin.close()
        except BrokenPipeError:
            pass

        buffer = bytearray()
        curr_info: Optional[CommitInfo] = None

        while True:
            chunk = proc.stdout.read(65536)
            if not chunk:
                break
            buffer.extend(chunk)
            while b"\x00" in buffer:
                pos = buffer.index(b"\x00")
                record = buffer[:pos].decode("utf-8", errors="replace")
                del buffer[: pos + 1]

                if "\x01" in record:
                    if curr_info:
                        sha_to_info[curr_info.sha] = curr_info
                        curr_info = None

                    meta_part, first_file = record.split("\x01", 1)
                    parts = meta_part.split("\n", 5)
                    if len(parts) >= 5 and len(parts[0].strip()) == 40:
                        sha = parts[0].strip().lower()
                        author_name = parts[1].strip()
                        try:
                            author_date = int(parts[2].strip())
                        except ValueError:
                            author_date = 0
                        try:
                            committer_date = int(parts[3].strip())
                        except ValueError:
                            committer_date = 0
                        subject = parts[4].strip()
                        body = parts[5] if len(parts) > 5 else ""

                        files = set()
                        if first_file.strip():
                            files.add(first_file.strip())

                        curr_info = CommitInfo(
                            sha=sha,
                            author_name=author_name,
                            author_date=author_date,
                            committer_date=committer_date,
                            subject=subject,
                            body=body,
                            files=files,
                        )
                elif curr_info:
                    f = record.strip()
                    if f:
                        curr_info.files.add(f)

        if curr_info:
            sha_to_info[curr_info.sha] = curr_info

        proc.stdout.close()
        proc.wait()
        return sha_to_info

    @staticmethod
    def process_subject_bucket(
        chunk_buckets: List[List[CommitInfo]],
    ) -> Tuple[int, List[Tuple[str, str]]]:
        """Worker function: Compare commits within subject buckets for timestamp matches."""
        author_date_matches = []

        for commits in chunk_buckets:
            n = len(commits)

            for i in range(n):
                c1 = commits[i]
                for j in range(i + 1, n):
                    c2 = commits[j]

                    if c1.files and c2.files and not (c1.files & c2.files):
                        continue

                    time_diff = abs(c1.author_date - c2.author_date) if (c1.author_date and c2.author_date) else float("inf")
                    if time_diff > MAX_MAINLINE_CYCLE_GAP:
                        continue

                    if c1.author_date > 0 and c1.author_date == c2.author_date:
                        author_date_matches.append((c1.sha, c2.sha))

        return len(chunk_buckets), author_date_matches

    @staticmethod
    def process_patch_id(args: Tuple[str, List[str]]) -> List[Tuple[str, str]]:
        """Worker function: Compute patch IDs for candidate SHAs."""
        repo_path, shas = args
        input_shas = "\n".join(shas) + "\n"

        log_cmd = [
            "git",
            "--no-pager",
            "log",
            "--ignore-missing",
            "--no-walk",
            "--no-merges",
            "--stdin",
            "-p",
            "--no-renames",
            "--no-abbrev-commit",
        ]
        log_proc = subprocess.Popen(
            log_cmd,
            cwd=repo_path,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            universal_newlines=True,
            errors="replace",
            bufsize=1024 * 1024,
        )

        patch_cmd = ["git", "patch-id", "--stable"]
        patch_proc = subprocess.Popen(
            patch_cmd,
            stdin=log_proc.stdout,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            universal_newlines=True,
            errors="replace",
            bufsize=1024 * 1024,
        )
        log_proc.stdout.close()

        try:
            log_proc.stdin.write(input_shas)
            log_proc.stdin.close()
        except BrokenPipeError:
            pass

        results = []
        for line in patch_proc.stdout:
            parts = line.strip().split()
            if len(parts) == 2:
                patch_id, sha = parts[0], parts[1].lower()
                if len(sha) == 40:
                    results.append((patch_id, sha))

        patch_proc.stdout.close()
        patch_proc.wait()
        log_proc.wait()
        return results


