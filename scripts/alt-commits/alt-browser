def resolve_target_shas(conn: sqlite3.Connection, target: str) -> List[str]:
    """Resolves a Group ID (e.g. 'g1042') or SHA / SHA prefix to a list of SHAs in DB."""
    clean = target.strip().lower()
    cur = conn.cursor()

    if clean.startswith("g") and clean[1:].isdigit():
        gid = int(clean[1:])
        cur.execute("SELECT lower(hex(hash_value)) FROM hashes WHERE group_id = ?", (gid,))
        return [r[0] for r in cur.fetchall()]

    if len(clean) == 40 and all(c in "0123456789abcdef" for c in clean):
        return [clean]

    cur.execute("SELECT lower(hex(hash_value)) FROM hashes WHERE hex(hash_value) LIKE ?", (clean.upper() + "%",))
    return [r[0] for r in cur.fetchall()]


def run_cli_mode(args, db_path: str):
    """CLI fallback mode when Textual is missing or --ignore/--unignore flags are passed."""
    ignored_shas, ignored_path = load_ignored_shas(args.ignored)

    if args.list_ignored:
        print(f"Ignored SHAs ({len(ignored_shas)} total) [{ignored_path}]:")
        for sha in sorted(ignored_shas):
            print(f"  {sha}")
        return

    has_actions = bool(args.ignore or args.unignore)

    if not has_actions:
        if not HAS_TEXTUAL:
            print("Notice: 'textual' Python module is not installed. TUI browser mode is unavailable.", file=sys.stderr)
            print("Install textual via 'pip install textual' for full TUI support.\n", file=sys.stderr)
            print("Command-line ignore options:", file=sys.stderr)
            print("  alt-browser -i e4e9b9248ff       # Ignore a commit SHA", file=sys.stderr)
            print("  alt-browser -i g1042             # Ignore an entire Group ID", file=sys.stderr)
            print("  alt-browser -u g1042             # Unignore a Group ID", file=sys.stderr)
            print("  alt-browser --list-ignored       # List currently ignored SHAs", file=sys.stderr)
            sys.exit(1)
        return

    if not os.path.exists(db_path):
        sys.stderr.write(f"Error: Database file '{db_path}' not found.\n")
        sys.exit(1)

    conn = sqlite3.connect(db_path)
    modified = False

    if args.ignore:
        for item in args.ignore:
            shas = resolve_target_shas(conn, item)
            if not shas:
                print(f"Warning: No matching commits found in DB for target '{item}'.", file=sys.stderr)
            else:
                for sha in shas:
                    ignored_shas.add(sha)
                print(f"Ignored {len(shas)} commit(s) for '{item}'.")
                modified = True

    if args.unignore:
        for item in args.unignore:
            shas = resolve_target_shas(conn, item)
            if not shas:
                print(f"Warning: No matching commits found in DB for target '{item}'.", file=sys.stderr)
            else:
                for sha in shas:
                    ignored_shas.discard(sha)
                print(f"Unignored {len(shas)} commit(s) for '{item}'.")
                modified = True

    conn.close()

    if modified:
        save_ignored_shas(ignored_path, ignored_shas)
        print(f"Saved updated ignore list to '{ignored_path}'.")


