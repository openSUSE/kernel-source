        """

        BINDINGS = [
            ("q", "quit", "Quit"),
            ("f", "filter", "Filter"),
            ("s", "search", "Search SHA"),
            ("m", "search_message", "Search Msg"),
            ("i", "toggle_ignored", "Ignore/Unignore"),
            ("I", "toggle_show_ignored", "Show/Hide Ignored"),
