    )
    parser.add_argument(
        "--no-scan",
        action="store_true",
        help="Do not run alt-scan automatically even if DB is missing or older than 1 week.",
    )

    args = parser.parse_args()
    db_path = resolve_db_path(args.db)
    check_and_auto_scan(db_path, args.no_scan)

    ignored_shas, ignored_path = load_ignored_shas(args.ignored, os.environ.get("LINUX_GIT"))
    allowed_types = parse_detection_types(args.types)

    if args.group is not None:
        lookup_group(db_path, args.group, ignored_shas, allowed_types)
    elif len(args.targets) == 2:
        compare_shas(db_path, args.targets[0], args.targets[1], ignored_shas, allowed_types)
    elif len(args.targets) == 1:
        if args.targets[0] == "stats":
            show_stats(db_path, ignored_path, ignored_shas, allowed_types)
        else:
            smart_lookup(db_path, args.targets[0], ignored_shas, allowed_types)
    else:
        parser.print_help(sys.stderr)
        sys.exit(1)