def parse_detection_types(val: str) -> set:
    """Parses detection types parameter (e.g. '3' -> {1, 2, 3} or '1,2' -> {1, 2})."""
    if not val:
        return {1, 2, 3}
    val = val.strip()
    if val.isdigit():
        n = int(val)
        return set(range(1, min(max(1, n) + 1, 4)))

    res = set()
    for item in re.split(r"[, ]+", val):
        if item.isdigit():
            dt = int(item)
            if 1 <= dt <= 3:
                res.add(dt)
    return res if res else {1, 2, 3}


def build_dt_clause(allowed_types: set) -> tuple:
    """Generates SQL WHERE fragment and parameter list for detection_type filtering."""
    if not allowed_types:
        return "", []
    placeholders = ",".join("?" for _ in allowed_types)
    return f"detection_type IN ({placeholders})", sorted(allowed_types)


def check_and_auto_scan(db_path: str, no_scan: bool = False):
    """Triggers alt-scan silently if db_path does not exist or is older than 1 week (7 days)."""
    if no_scan:
        return

    ONE_WEEK_SECONDS = 7 * 24 * 3600
    should_scan = False

    if not os.path.exists(db_path):
        should_scan = True
    else:
        try:
            mtime = os.path.getmtime(db_path)
            if (time.time() - mtime) > ONE_WEEK_SECONDS:
                should_scan = True
        except Exception:
            pass

    if should_scan:
        script_dir = os.path.dirname(os.path.abspath(__file__))
        local_scan = os.path.join(script_dir, "alt-scan")
        if os.path.exists(local_scan) and os.access(local_scan, os.X_OK):
            cmd = [local_scan, "--db", db_path, "--quiet"]
        elif os.path.exists(local_scan):
            cmd = [sys.executable, local_scan, "--db", db_path, "--quiet"]
        else:
            cmd = ["alt-scan", "--db", db_path, "--quiet"]

        try:
            subprocess.run(cmd, check=True)
        except Exception as e:
            sys.stderr.write(f"Warning: Failed to run alt-scan automatically: {e}\n")


def resolve_sha_group(db_path: str, query_hash: str, ignored_shas: set, allowed_types: set) -> int:
    """Resolves a full or short SHA to its group_id, ignoring ignored SHAs and unallowed detection types."""
    if not os.path.exists(db_path):
        sys.stderr.write(f"Error: Database file '{db_path}' not found.\n")
        sys.exit(1)

    clean_hash = query_hash.strip().lower()

    if not all(c in "0123456789abcdef" for c in clean_hash):
        sys.stderr.write(f"Error: '{query_hash}' is not a valid hexadecimal commit SHA.\n")
        sys.exit(1)

    if clean_hash in ignored_shas and len(clean_hash) == 40:
        sys.stderr.write(f"Error: Commit SHA '{clean_hash}' not found in database.\n")
        sys.exit(1)

    conn = get_db_connection(db_path)
    cur = conn.cursor()

    dt_clause, dt_params = build_dt_clause(allowed_types)

    if len(clean_hash) < 40:
        query = "SELECT hex(hash_value) FROM hashes WHERE hex(hash_value) LIKE ?"
        params = [clean_hash.upper() + "%"]
        if dt_clause:
            query += f" AND {dt_clause}"
            params.extend(dt_params)

        cur.execute(query, params)
        matches = [r[0].lower() for r in cur.fetchall() if r[0].lower() not in ignored_shas]

        if not matches:
            sys.stderr.write(f"Error: No commits matching prefix '{clean_hash}' found.\n")
            conn.close()
            sys.exit(1)
        elif len(matches) > 1:
            sys.stderr.write(f"Error: Ambiguous prefix '{clean_hash}' matches {len(matches)} commits.\n")
            conn.close()
            sys.exit(1)
        else:
            clean_hash = matches[0]

    target_blob = bytes.fromhex(clean_hash)
    query = "SELECT group_id FROM hashes WHERE hash_value = ?"
    params = [target_blob]
    if dt_clause:
        query += f" AND {dt_clause}"
        params.extend(dt_params)

    cur.execute(query, params)
    row = cur.fetchone()
    conn.close()

    if not row or clean_hash in ignored_shas:
        sys.stderr.write(f"Error: Commit SHA '{clean_hash}' not found in database.\n")
        sys.exit(1)

    return row[0]


def compare_shas(db_path: str, sha1: str, sha2: str, ignored_shas: set, allowed_types: set):
    """Checks if two SHAs belong to the same group and exits with 0 on match or 1 on mismatch."""
    group1 = resolve_sha_group(db_path, sha1, ignored_shas, allowed_types)
    group2 = resolve_sha_group(db_path, sha2, ignored_shas, allowed_types)

    if group1 == group2:
        sys.exit(0)
    else:
        sys.exit(1)


def lookup_group(db_path: str, group_id: int, ignored_shas: set, allowed_types: set):
    """Prints all non-ignored commit hashes belonging to a specific group_id."""
    if not os.path.exists(db_path):
        sys.stderr.write(f"Error: Database file '{db_path}' not found.\n")
        sys.exit(1)

    conn = get_db_connection(db_path)
    cur = conn.cursor()

    dt_clause, dt_params = build_dt_clause(allowed_types)
    query = "SELECT hex(hash_value) FROM hashes WHERE group_id = ?"
    params = [group_id]
    if dt_clause:
        query += f" AND {dt_clause}"
        params.extend(dt_params)

    cur.execute(query, params)
    rows = cur.fetchall()
    conn.close()

    for r in rows:
        sha = r[0].lower()
        if sha not in ignored_shas:
            sys.stdout.write(f"{sha}\n")


def lookup_hash(db_path: str, query_hash: str, ignored_shas: set, allowed_types: set):
    """Prints all sibling non-ignored hashes sharing a group with target SHA."""
    group_id = resolve_sha_group(db_path, query_hash, ignored_shas, allowed_types)

    conn = get_db_connection(db_path)
    cur = conn.cursor()

    clean_hash = query_hash.strip().lower()
    dt_clause, dt_params = build_dt_clause(allowed_types)

    query = "SELECT hex(hash_value) FROM hashes WHERE group_id = ? AND hex(hash_value) NOT LIKE ?"
    params = [group_id, clean_hash + "%"]
    if dt_clause:
        query += f" AND {dt_clause}"
        params.extend(dt_params)

    cur.execute(query, params)
    results = cur.fetchall()
    conn.close()

    for r in results:
        sha = r[0].lower()
        if sha not in ignored_shas:
            sys.stdout.write(f"{sha}\n")


def smart_lookup(db_path: str, target: str, ignored_shas: set, allowed_types: set):
    """Automatically detects whether target is a Group ID ('g' prefix) or commit SHA."""
    clean = target.strip().lower()

    # Group IDs MUST be specified with the 'g' prefix (e.g., 'g1042')
    if clean.startswith("g"):
        gid_str = clean[1:]
        if gid_str.isdigit():
            lookup_group(db_path, int(gid_str), ignored_shas, allowed_types)
            return
        else:
            sys.stderr.write(f"Error: Invalid group ID format '{target}'. Expected g<number> (e.g., 'g1042').\n")
            sys.exit(1)

    # All non-g targets are treated strictly as commit SHAs or SHA prefixes
    lookup_hash(db_path, clean, ignored_shas, allowed_types)


def show_stats(db_path: str, ignored_path: str, ignored_shas: set, allowed_types: set):
    """Displays statistics excluding ignored commit SHAs and unallowed detection types."""
    if not os.path.exists(db_path):
        sys.stderr.write(f"Error: Database file '{db_path}' not found.\n")
        sys.exit(1)

    where_conditions = []
    params = []

    if ignored_shas:
        placeholders = ",".join("?" for _ in ignored_shas)
        where_conditions.append(f"lower(hex(hash_value)) NOT IN ({placeholders})")
        params.extend(list(ignored_shas))

    if allowed_types:
        dt_placeholders = ",".join("?" for _ in allowed_types)
        where_conditions.append(f"detection_type IN ({dt_placeholders})")
        params.extend(sorted(allowed_types))

    where_clause = " WHERE " + " AND ".join(where_conditions) if where_conditions else ""

    conn = get_db_connection(db_path)
    cur = conn.cursor()

    cur.execute(f"SELECT COUNT(*) FROM hashes {where_clause}", params)
    total_hashes = cur.fetchone()[0]

    cur.execute(f"SELECT COUNT(DISTINCT group_id) FROM hashes {where_clause}", params)
    total_groups = cur.fetchone()[0]

    cur.execute(
        f"SELECT detection_type, COUNT(*) FROM hashes {where_clause} GROUP BY detection_type",
        params,
    )
    type_counts = dict(cur.fetchall())

    min_sz, max_sz, avg_sz = (0, 0, 0.0)
    top_groups = []

    if total_groups > 0:
        cur.execute(
            f"""
            WITH group_sizes AS (
                SELECT COUNT(*) AS sz FROM hashes {where_clause} GROUP BY group_id
            )
            SELECT MIN(sz), MAX(sz), AVG(sz) FROM group_sizes
        """,
            params,
        )
        min_sz, max_sz, avg_sz = cur.fetchone()

        cur.execute(
            f"""
            SELECT group_id, COUNT(*) as cnt
            FROM hashes
            {where_clause}
            GROUP BY group_id
            ORDER BY cnt DESC
            LIMIT 5
        """,
            params,
        )
        top_groups = cur.fetchall()

    cur.execute("SELECT value FROM state WHERE key = 'last_commit'")
    row = cur.fetchone()
    last_commit = row[0] if row else "None"

    db_size = os.path.getsize(db_path)
    conn.close()

    allowed_str = ", ".join(str(t) for t in sorted(allowed_types))

    print("=============================================")
    print("        DATABASE METRICS & STATISTICS        ")
    print("=============================================")
    print(f"Database Path:        {os.path.abspath(db_path)}")
    print(f"Ignored Path:         {os.path.abspath(ignored_path)}")
    print(f"File Size:            {format_size(db_size)}")
    print(f"Active Types Filter:  [{allowed_str}]")
    print(f"Last Checkpoint SHA:  {last_commit}")
    print(f"Ignored SHAs:         {len(ignored_shas):,}")
    print("---------------------------------------------")
    print(f"Total Linked Hashes:  {total_hashes:,}")
    print(f"Total Unique Groups:  {total_groups:,}")
    print("---------------------------------------------")
    print("Detection Type Breakdown:")

    if total_hashes > 0:
        for dt_code in sorted(allowed_types):
            label = DETECTION_LABELS.get(dt_code, f"Unknown Type #{dt_code}")
            cnt = type_counts.get(dt_code, 0)
            pct = (cnt / total_hashes) * 100.0
            print(f"  - {label:<30}: {cnt:>8,} ({pct:5.1f}%)")
    else:
        print("  (No entry records matching filter criteria)")

    if total_groups > 0:
        print("---------------------------------------------")
        print(f"Min Group Size:       {min_sz}")
        print(f"Max Group Size:       {max_sz}")
        print(f"Avg Group Size:       {avg_sz:.2f} hashes/group")
        print("---------------------------------------------")
        print("Top 5 Largest Commit Groups:")
        for gid, count in top_groups:
            print(f"  - Group #{gid}: {count} commits")
    print("=============================================")


if __name__ == "__main__":
