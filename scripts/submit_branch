#!/bin/sh -xe

project=Devel:Kernel:SL-16.1-NV:Submit

scripts/tar-up
scripts/osc_wrapper --ibs upload --debug --reset-branch $project
scripts/osc_wrapper --ibs upload --debug --reset-branch $project-Main
echo Write PR subject or ^C to exit
read x
scripts/osc_wrapper --ibs upload --no-init --submit="$x" $project
scripts/osc_wrapper --ibs upload --no-init $project-Main
tea pr c --edits --repo pool/kernel-source-nvidia --head $(tea whoami | sed -e 's/[# ]//g' -e '/^$/d' | head -n 1):Devel/Kernel/SL-16.1-NV/Submit-Main -t "$x"
