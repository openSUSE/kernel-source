#!/usr/bin/python3

from obsapi.obsapi import OBSAPI
import argparse
import json
import sys
import os

parser = argparse.ArgumentParser()
parser.add_argument('tar_up_dir')
parser.add_argument('-A', '--api-url', nargs=1, required=True)
parser.add_argument('-l', '--log', nargs=1, help='log API calls to file')

args = parser.parse_args()

logfile = None
if args.log:
    logfile = open(args.log[0], 'a')
    sys.stderr.write('Logging API calls to %s\n' % (logfile.name,))

repo_archs = OBSAPI(args.api_url[0], logfile=logfile).get_repo_archs(args.tar_up_dir)

print(json.dumps(repo_archs))
