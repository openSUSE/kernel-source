#!/usr/bin/python3

from obsapi.obsapi import OBSAPI
import argparse
import json
import os

parser = argparse.ArgumentParser()
parser.add_argument('tar_up_dir')
parser.add_argument('-A', '--api-url', nargs=1, required=True)

args = parser.parse_args()

repo_archs = OBSAPI(args.api_url[0]).get_repo_archs(args.tar_up_dir)

print(json.dumps(repo_archs))
