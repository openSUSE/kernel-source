#
# This hook annotates merge commit messages with information about files
# that were automatically resolved using custom merge drivers.

import argparse
import os
import sys
import subprocess

from kutil import pygit2_wrapper as pygit2

parser = argparse.ArgumentParser(description="Modify commit message after custom merge driver actions")

parser.add_argument("commit_file")
parser.add_argument("commit_source", nargs='?')
parser.add_argument("commit_sha", nargs='?')

args = parser.parse_args()

# Only process selected commits
source_repo = pygit2.Repository('.')
log_file = os.path.join(source_repo.path, "MERGE_DRIVER_LOG")

heads = {
        "MERGE_HEAD":       ["merge", "Merge resolved"],
        "CHERRY_PICK_HEAD": ["message", "Cherry-pick resolved"],
        "REBASE_HEAD":      ["message", "Rebase resolved"],
}
head = None
for h in heads.keys(): # random but trust git repo's cleanliness
    if os.path.exists(os.path.join(source_repo.path, h)):
        head = h
        break

if not head or args.commit_source != heads[head][0]:
    if os.path.exists(log_file):
        print("Removing stale %s" % log_file)
        os.remove(log_file)
    sys.exit(0)


# Check if we have a merge driver log
if not os.path.exists(log_file):
    sys.exit(0)

# Read the log and collect file:driver pairs
file_driver_pairs = []
with open(log_file, "r") as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        parts = line.split(":", 1)
        if len(parts) == 2:
            driver, filepath = parts
            if driver and filepath:
                file_driver_pairs.append((filepath, driver))

# Clean up the log file
os.remove(log_file)

# If no drivers were used, exit
if not file_driver_pairs:
    sys.exit(0)

# Append merge driver information to commit message
with open(args.commit_file, "a") as f:
    f.write("\n")
    f.write(f"{heads[head][1]} automatically by custom merge drivers:\n")
    for filepath, driver in file_driver_pairs:
        f.write(f"  - {filepath}: {driver}\n")

sys.exit(0)
