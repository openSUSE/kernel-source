#!/usr/bin/python3
import argparse
import bugzilla, sys
from bugzilla._cli import DEFAULT_BZ

parser = argparse.ArgumentParser(description="Query Bugzilla bugs assigned to an email.")
group = parser.add_mutually_exclusive_group()
group.add_argument("-n", "--needinfo-too", action="store_true", help="Include also bugs where needinfo is requested")
group.add_argument("-N", "--needinfo-only", action="store_true", help="List only bugs where needinfo is requested")
parser.add_argument("email", help="Bugzilla email address")
args = parser.parse_args()

if len(args.email) < 9:
    print("no valid bz email provided")
    sys.exit(1)

bzapi = bugzilla.Bugzilla(DEFAULT_BZ)
base_query = bzapi.build_query(status=['NEW', 'IN_PROGRESS', 'CONFIRMED'],
                          include_fields=["id", "status", "summary"])

if not args.needinfo_only:
    query1 = dict(base_query)
    query1['assigned_to'] = args.email
    bugs1 = bzapi.query(query1)
else:
    bugs1 = []

if args.needinfo_too or args.needinfo_only:
    query2 = dict(base_query)
    query2['f1'] = 'requestees.login_name'
    query2['o1'] = 'equals'
    query2['v1'] = args.email
    bugs2 = bzapi.query(query2)
else:
    bugs2 = []

bids1 = set(b.id for b in bugs1)
bugs = bugs1 + [b for b in bugs2 if b.id not in bids1]

for b in bugs:
    print("{} ; {:<13} ; {}".format(b.id, b.status, b.summary))
