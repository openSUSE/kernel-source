#!/bin/bash

# Usage
# scripts/sha2series sha [cmd_to_run]
#
# Tries to find a ML posting for the given sha and if this is a part of
# multi-patch series then tries to find commits for all patches in the series.
#
# example
# $ scripts/sha2series e045d6ed33f8 git -C $LINUX_GIT/.git show-oneline
# e045d6ed33f8 ("md/raid10: fix writes_pending leak on write request failures") by abd.masalkhi@gmail.com
# https://patch.msgid.link/20260613182810.1317258-3-abd.masalkhi@gmail.com
# Found 4 patches on the ML
# a4c55c902670 ("md/raid1: simplify raid1_write_request() error handling")
# 393d687131d8 ("md/raid10: fix writes_pending and barrier reference leaks on discard failures")
# e045d6ed33f8 ("md/raid10: fix writes_pending leak on write request failures")
# 8e065a160251 ("md/raid1: fix writes_pending and barrier reference leaks on write failures")
#
tmpdir=$(mktemp -d )
trap 'rm -rf "$tmpdir"' EXIT
mbox_file=$tmpdir/mbox

sha=$1
author="$(git -C $LINUX_GIT/.git show -s --pretty='format:%ae' $sha)"
(
	cd $LINUX_GIT
	echo "$(git show -s --pretty='format:%h ("%s")' $sha) by $author"
	b4 dig -c $sha -m $mbox_file 2>&1 | grep "https://"
)
grep "^Subject: \[PATCH" $mbox_file | grep -v "[[:space:]]\+0\+" | sed 's@.*[0-9]\+\][[:space:]]\+\(.*\)@"^\1"@' > $tmpdir/subjects

nr_patches=$(wc -l $tmpdir/subjects | cut -d" " -f1)
if [ $nr_patches -le 1 ]
then
	echo "Too few patches $nr_patches"
	exit 0
fi

echo "Found $nr_patches patches on the ML"

patchfiles=$(lsdiff --strip 1 $mbox_file | sort -u)
base_range="$(git -C $LINUX_GIT/.git describe $sha | cut -d- -f1)..origin/master"

shift
cmd="$@"
: ${cmd:="echo"}
xargs -d '\n' -I {} echo --grep={} < $tmpdir/subjects | xargs git -C $LINUX_GIT/.git --no-pager log --pretty="format:%H" --author=$author $base_range | xargs $cmd
