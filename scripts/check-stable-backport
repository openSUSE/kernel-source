#!/bin/bash

usage()
{
	cat << EOF
Usage
	scripts/check-stable-backport [-a] [-h] [-c] branch sha[ sha...]

Checks backports of given sha(s) in closest actively maitained stable tree and
reports if the backport has been contributed by non-stable tree maintainers.
With -a parameter it reports all actively maintained stable which contian the
backported fix.
With -c parameter only reports stable backports with non-stable maintainer
conributor

Expects:
LINUX_GIT - to point to Linus tree clone
STABLE_GIT - to point to stable tree clone (LINUX_GIT by default)
STABLE_REMOTE - name of the stable tree remote (stable by default)
EOF
}

fail()
{
	echo "$@" >&2
	exit 1
}

active_stable_vers()
{
	curl -sL https://www.kernel.org/releases.json | jq -r '
  .releases[]
  | select(.iseol == false and (.moniker == "stable" or .moniker == "longterm"))
  | .version
' | cut -d. -f1,2

}

closest_stable_match()
{
	local ver=$1
	local closest_lower=$(printf "%s\n%s\n" "$stable_vers" "$ver" \
	  | sort -Vu \
	  | grep -B 1 -F -x "$ver" \
	  | head -n 1)

	local closest_higher=$(printf "%s\n%s\n" "$stable_vers" "$ver" \
	  | sort -Vu \
	  | grep -A 1 -F -x "$ver" \
	  | tail -n 1)

	# If no older tree is there then the closest newer
	if [ $ver = $closest_lower ]
	then
		echo $closest_higher
	else
		echo $closest_lower
	fi
}

eval_backport()
{
	local sha=$1
	local stable_sha=$2
	local stable_ver=$3
	local only_contributed=$4

	local sob_pattern="(acked|reviewed|signed-off|tested)-by"
	local stable_maintainers="(Sasha Levin|Greg Kroah-Hartman)"
	git -C $LINUX_GIT show --pretty="%b" $sha | grep -iE $sob_pattern > $tmpdir/$sha.sob
	git -C $STABLE_GIT show --pretty="%b" $stable_sha | grep -iE $sob_pattern > $tmpdir/$stable_sha.sob
	diff -u $tmpdir/$sha.sob $tmpdir/$stable_sha.sob | grep -iE "^\+$sob_pattern" | sed 's@^\+@@' | grep -viE "$stable_maintainers" > $tmpdir/$stable_sha.sob_changes
	if [ -s "$tmpdir/$stable_sha.sob_changes" ]
	then
		echo -n "$sha stable backport in $stable_ver $stable_sha "
		echo -e "\tnon-stable s-o-b $(cat $tmpdir/$stable_sha.sob_changes | tr "\n" "," )"
		return 0
	fi
	[ -n "$only_contributed" ] && return 1
	echo -n "$sha stable backport in $stable_ver $stable_sha "
	echo -e "\tstable maintainer backport"
	return 0
}

test_stable_ver()
{
	local ver=$1
	git -C $STABLE_GIT rev-parse $STABLE_REMOTE/linux-$ver.y >/dev/null 2>&1
}

. $(dirname $0)/common-functions

do_all=
only_contributed=
while getopts "hac" OPT
do
	case $OPT in
		h) usage ;;
		a) do_all=1 ;;
		c) only_contributed=1 ;;
	esac
done
shift "$(($OPTIND-1))"

branch=$1
shift

[ -z "$branch" ] && fail "No branch provided"

base_ver=$(branch_base_ver $branch)
base_ver=${base_ver#v}

[ -z "$STABLE_GIT" ] && STABLE_GIT=$LINUX_GIT
[ -z "$STABLE_REMOTE" ] && STABLE_REMOTE=stable

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

git -C $STABLE_GIT rev-parse $STABLE_REMOTE >/dev/null 2>&1 || fail "Cannot find $STABLE_REMOTE at $STABLE_GIT"


stable_vers="$(active_stable_vers)"
if test_stable_ver $base_ver
then
	exact_ver=$base_ver
else
	closest_lower=$(printf "%s\n%s\n" "$stable_vers" "$base_ver" \
	  | sort -Vu \
	  | grep -B 1 -F -x "$base_ver" \
	  | head -n 1)

	closest_higher=$(printf "%s\n%s\n" "$stable_vers" "$base_ver" \
	  | sort -Vu \
	  | grep -A 1 -F -x "$base_ver" \
	  | tail -n 1)
	echo -n "branch:$branch ($base_ver) closest stable"
	if test_stable_ver $closest_lower
	then
		echo -n " linux-$closest_lower.y"
	else
		closest_lower=""
	fi

	if test_stable_ver $closest_higher
	then
		echo -n " linux-$closest_higher.y"
	else
		closest_higher=""
	fi
	echo
fi

check_vers="$exact_ver $closest_lower $closest_higher $stable_vers"
[ -n "$do_all" ] && check_vers="$stable_vers"

for s in $@
do
	sha="$(git -C $LINUX_GIT rev-parse $s)"
	sha_pattern="(commit $sha upstream|upstream commit $sha|\[ upstream commit $sha \]|cherry picked from commit $sha|this is backport of $sha)"
	found=0
	for stable_ver in $check_vers
	do
		stable_sha="$(git -C $STABLE_GIT log --pretty="format:%H" -i -E --grep "$sha_pattern" v$stable_ver..$STABLE_REMOTE/linux-$stable_ver.y)"
		[ -n "$stable_sha" ] || continue

		if eval_backport $sha $stable_sha $stable_ver $only_contributed
		then
			found=1
			[ -z "$do_all" ] && break
		fi
	done
	[ $found -eq 0 ] && echo "$sha not found in any stable tree"
done
