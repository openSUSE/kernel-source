From aae3d292fece215de7e44ebfa6b15ccf6e3de1b5 Mon Sep 17 00:00:00 2001
From: Takashi Iwai <tiwai@suse.de>
Date: Wed, 3 Jun 2026 14:50:16 +0200
Subject: [PATCH] kbuild: dummy-tools: Add rustc and bindgen
Patch-mainline: Never, SUSE-specific for now
References: bsc#1258538

This patch adds the rustc and bindgen dummy scripts, so that you can
have consistent kconfig values that are related with Rust, mostly
useful for preparing the distro's kconfigs.

The script just returns some versions that satisfy the builds, and it
mimics the rustc sysroot as if the required library code were present.

The rustc version is set to 1.96, so that it can cover the minimal
version.

Signed-off-by: Takashi Iwai <tiwai@suse.de>

---
 scripts/dummy-tools/bindgen                   | 34 +++++++++++++
 .../rustlib/src/rust/library/core/src/lib.rs  |  1 +
 scripts/dummy-tools/rustc                     | 49 +++++++++++++++++++
 3 files changed, 84 insertions(+)
 create mode 100755 scripts/dummy-tools/bindgen
 create mode 100644 scripts/dummy-tools/lib/rustlib/src/rust/library/core/src/lib.rs
 create mode 100755 scripts/dummy-tools/rustc

diff --git a/scripts/dummy-tools/bindgen b/scripts/dummy-tools/bindgen
new file mode 100755
index 000000000000..66245b96df10
--- /dev/null
+++ b/scripts/dummy-tools/bindgen
@@ -0,0 +1,34 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0-only
+
+# Check if the first parameter appears in the rest. Succeeds if found.
+# This helper is useful if a particular option was passed to this script.
+# Typically used like this:
+#   arg_contain <word-you-are-searching-for> "$@"
+arg_contain ()
+{
+	search="$1"
+	shift
+
+	while [ $# -gt 0 ]
+	do
+		if [ "$search" = "$1" ]; then
+			return 0
+		fi
+		shift
+	done
+
+	return 1
+}
+
+if arg_contain --version "$@"; then
+   echo "bindgen 0.71.1"
+   exit 0
+fi
+
+# FIXME: assuming the pragma-messages for clang version check
+echo "clang diag: xxx:0:0: warning: clang version 21.1.8  [-W#pragma-messages]" >&2
+echo "/* automatically generated by rust-bindgen 0.71.1 */"
+echo
+echo
+exit 0
diff --git a/scripts/dummy-tools/lib/rustlib/src/rust/library/core/src/lib.rs b/scripts/dummy-tools/lib/rustlib/src/rust/library/core/src/lib.rs
new file mode 100644
index 000000000000..b262fa10a3a2
--- /dev/null
+++ b/scripts/dummy-tools/lib/rustlib/src/rust/library/core/src/lib.rs
@@ -0,0 +1 @@
+// dummy file
diff --git a/scripts/dummy-tools/rustc b/scripts/dummy-tools/rustc
new file mode 100755
index 000000000000..77f39bad21aa
--- /dev/null
+++ b/scripts/dummy-tools/rustc
@@ -0,0 +1,49 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0-only
+
+self="$0"
+
+dummydir="$(dirname "$self")"
+
+# Check if the first parameter appears in the rest. Succeeds if found.
+# This helper is useful if a particular option was passed to this script.
+# Typically used like this:
+#   arg_contain <word-you-are-searching-for> "$@"
+arg_contain ()
+{
+	search="$1"
+	shift
+
+	while [ $# -gt 0 ]
+	do
+		if [ "$search" = "$1" ]; then
+			return 0
+		fi
+		shift
+	done
+
+	return 1
+}
+
+if arg_contain --version "$@"; then
+    echo "rustc 1.96.0 (123456789 2026-01-01)"
+    if arg_contain --verbose "$@"; then
+        echo "binary: rustc
+commit-hash: 1234567890123456789012345678901234567890
+commit-date: 2026-01-21
+host: x86_64-unknown-linux-gnu
+release: 1.96.0
+LLVM version: 21.1.8"
+    fi
+    exit 0
+fi
+
+# called for checking rust core standard library
+if arg_contain --print "$@"; then
+    if arg_contain sysroot "$@"; then
+	echo "$dummydir"
+	exit 0
+    fi
+    echo "Unknown --print option"
+    exit 1
+fi
-- 
